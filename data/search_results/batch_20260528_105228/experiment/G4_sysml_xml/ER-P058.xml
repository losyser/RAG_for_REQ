    <Requirement id="ER-P058-03" level="1" requirementType="reliability">
      <sysml:Name>膨胀水箱防失压保护</sysml:Name>
      <sysml:Text>膨胀水箱应通过低液位报警和自动补水功能防止因泄漏导致系统失压。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P058" />
      <sysml:Traceability>
        <Evidence id="E-EXP-CAP-001" supportStatus="supported_by_indirect_evidence" />
        <Evidence id="E-COMM-COOL-001" supportStatus="supported_by_indirect_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>supported_by_indirect_evidence</SupportStatus>
        <RiskIfUnmet>系统失压将导致冷却水循环中断，主机过热停机。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查图纸确认膨胀水箱安装位置位于回路最高点，并设有液位计和低液位报警。</Criterion>
        <Criterion>调试期间模拟泄漏工况，确认低液位报警触发后自动补水功能启动，系统压力维持稳定，具体参数按主机厂家 Technical Data 确认。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【膨胀水箱防失压保护】，来自原始需求「防止因泄漏导致系统失压」。E-EXP-CAP-001（DNV规则）支撑了膨胀水箱位于回路最高点确保自由膨胀和排气，间接支撑防失压；E-COMM-COOL-001（调试程序）包含低液位报警验证。</sysml:EngineeringRationale>
