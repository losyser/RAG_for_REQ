  <ProfessionalSummary>覆盖膨胀水箱低液位报警、自动补水控制和防失压保护要求，基于船级社规则和标准证据。</ProfessionalSummary>
  <EngineeringRequirements count="3">
    <Requirement id="ER-P058-01" level="1" requirementType="alarm_protection">
      <sysml:Name>膨胀水箱低液位报警</sysml:Name>
      <sysml:Text>膨胀水箱应设置低液位声光报警装置，报警信号应接入集控室和驾驶台监控系统。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P058" />
      <sysml:Traceability>
        <Evidence id="E-CTRL-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-ISO8861-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-EXP-CAP-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>低液位无报警将导致操作人员无法及时发现泄漏，可能造成系统失压和主机损坏。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查图纸确认低液位报警传感器安装位置和报警回路设计符合本条要求。</Criterion>
        <Criterion>调试期间模拟低液位，确认声光报警在集控室和驾驶台正确触发，具体报警设定值按主机厂家 Technical Data 确认。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【膨胀水箱低液位报警】，来自原始需求「低液位声光报警」。E-CTRL-COOL-002（IACS UR E10）支撑了低液位报警要求；E-ISO8861-002（ISO 8861:1998）支撑了报警应在机控室和驾驶台显示；E-EXP-CAP-001（DNV规则）支撑了装设低液位报警。</sysml:EngineeringRationale>
      <sysml:QualityGateReport passed="true" score="1.0">
        <Check dimension="evidence_sufficiency" passed="true" severity="error">
          <Message>Evidence present: 3 item(s), support_status='verified_by_direct_evidence'.</Message>
        </Check>
        <Check dimension="verifiability" passed="true" severity="error">
          <Message>Verifiable: method='commissioning_check', 2 criterion/criteria defined.</Message>
        </Check>
        <Check dimension="over_inference" passed="true" severity="error">
          <Message>No over-inference detected.</Message>
        </Check>
        <Check dimension="ambiguity" passed="true" severity="warning">
          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 4 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P058-02" level="1" requirementType="control">
      <sysml:Name>膨胀水箱自动补水控制</sysml:Name>
      <sysml:Text>膨胀水箱应具备自动补水功能，当液位低于设定值时自动启动补水。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P058" />
      <sysml:QualityStatus>
        <SupportStatus>evidence_gap</SupportStatus>
        <RiskIfUnmet>无自动补水功能时，泄漏导致液位下降无法自动恢复，可能造成系统失压。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>待补充相关工程证据后方可确认验收判据。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【膨胀水箱自动补水控制】，来自原始需求「自动补水功能」。E-COMM-COOL-001（调试程序）间接支撑了低液位报警验证，但未直接给出自动补水控制要求；evidence_gap_summary 中 P058-02 子需求明确要求自动补水功能。</sysml:EngineeringRationale>
