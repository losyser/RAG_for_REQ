          <Message>evidence_ids is empty — requirement has no evidence backing.</Message>
          <Suggestion>Retrieve and link at least one supporting evidence item from the evidence database.</Suggestion>
        </Check>
        <Check dimension="verifiability" passed="true" severity="error">
          <Message>Verifiable: method='review', 1 criterion/criteria defined.</Message>
