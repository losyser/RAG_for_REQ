          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 4 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P082-02" level="1" requirementType="maintainability">
      <sysml:Name>冷却水侧可拆卸端盖</sysml:Name>
      <sysml:Text>中央冷却器冷却水侧应设有可拆卸的端盖，以便于内部检查和清洗。</sysml:Text>
      <sysml:VerifiedBy method="inspection" />
      <sysml:DerivedFrom refId="ER-P082" />
      <sysml:Traceability>
        <Evidence id="E-SUPP-MAINT-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-SUPP-MAINT-002" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>无法进行内部检查和清洗，导致冷却器结垢堵塞，换热效率下降，影响主机冷却效果。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查冷却器图纸，确认冷却水侧设有可拆卸端盖或等效的可拆芯/可拆板式结构。</Criterion>
        <Criterion>现场检查确认端盖拆卸所需空间满足维护通道间距要求（泵轴向≥1.5倍泵长，板换需留全板束抽出空间，阀操作侧≥600mm，通道宽≥600mm）。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【冷却水侧可拆卸端盖】，来自原始需求「冷却水侧应设有可拆卸的端盖以便于内部检查和清洗」。E-SUPP-MAINT-001（DNV规则）支撑了冷却器维护空间要求；E-SUPP-MAINT-002（模块化快拆设计）直接支撑可拆芯或可拆板式结构要求。</sysml:EngineeringRationale>
      <sysml:QualityGateReport passed="true" score="1.0">
        <Check dimension="evidence_sufficiency" passed="true" severity="error">
          <Message>Evidence present: 2 item(s), support_status='verified_by_direct_evidence'.</Message>
        </Check>
        <Check dimension="verifiability" passed="true" severity="error">
          <Message>Verifiable: method='inspection', 2 criterion/criteria defined.</Message>
        </Check>
        <Check dimension="over_inference" passed="true" severity="error">
          <Message>No over-inference detected.</Message>
        </Check>
        <Check dimension="ambiguity" passed="true" severity="warning">
          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 4 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
