  <EngineeringRequirements count="3">
    <Requirement id="ER-P095-01" level="1" requirementType="maintainability">
      <sysml:Name>管路阀门标识与编号</sysml:Name>
      <sysml:Text>主机冷却水系统管路和阀门应标注流向标识和唯一编号，标识应清晰、耐久，并符合船级社或项目规范要求。</sysml:Text>
      <sysml:VerifiedBy method="inspection" />
      <sysml:DerivedFrom refId="ER-P095" />
      <sysml:Traceability>
        <Evidence id="E-SUPP-MAINT-001" supportStatus="supported_by_indirect_evidence" />
        <Evidence id="E-SUPP-MAINT-002" supportStatus="supported_by_indirect_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>supported_by_indirect_evidence</SupportStatus>
        <RiskIfUnmet>无标识或编号不清晰将导致运维人员无法快速识别，延长故障定位时间。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查图纸和现场，确认所有管路和阀门已标注流向标识和唯一编号。</Criterion>
        <Criterion>标识耐久性按项目规范或船级社要求确认。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【管路阀门标识与编号】，来自原始需求「标注流向标识和编号」。E-SUPP-MAINT-001 支撑了维护通道间距要求，间接支撑标识便于维护；E-SUPP-MAINT-002 支撑了模块化快拆设计，间接支撑标识便于快速识别。</sysml:EngineeringRationale>
