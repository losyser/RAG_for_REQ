    <Requirement id="ER-P029-03" level="1" requirementType="environmental">
      <sysml:Name>化学品误排放风险控制</sysml:Name>
      <sysml:Text>主机冷却水系统应设置废液收集和处理措施，防止含铬、亚硝酸盐或乙二醇的冷却液直接排海。</sysml:Text>
      <sysml:VerifiedBy method="review" />
      <sysml:DerivedFrom refId="ER-P029" />
      <sysml:Traceability>
        <Evidence id="E-SUPP-ENV-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-SYS-WATER-010" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>化学品误排放违反 MARPOL，导致罚款和环境污染。</RiskIfUnmet>
        <ApplicabilityConstraint>E-SYS-WATER-010 基于 Wärtsilä 32，其他机型应参照厂家资料。</ApplicabilityConstraint>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>确认膨胀水箱溢流管不排入大海，废液收集至专用柜。</Criterion>
        <Criterion>确认废液处理程序符合 MARPOL 要求，含铬/亚硝酸盐/乙二醇废液送岸上设施。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【化学品误排放风险控制】，来自原始需求「化学品误排放风险」。E-SUPP-ENV-001 直接支撑了废液禁止排海和溢流管要求；E-SYS-WATER-010 间接支撑了排放收集柜设置。</sysml:EngineeringRationale>
