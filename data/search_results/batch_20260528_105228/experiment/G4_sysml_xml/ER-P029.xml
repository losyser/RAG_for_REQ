<RequirementSet xmlns:sysml="http://www.omg.org/spec/SysML/20181001/CoolingRAG/Requirements" setId="ER-P029" sourceRequirementId="P029" stakeholder="环保负责人" generationBasis="original_requirement_and_supported_evidence_only" generatedAt="2026-05-28T11:07:47">
  <ProfessionalSummary>覆盖冷却水系统减少冷却液泄漏、海水泄漏和化学品误排放风险，满足项目环保要求。</ProfessionalSummary>
  <EngineeringRequirements count="4">
    <Requirement id="ER-P029-01" level="1" requirementType="safety">
      <sysml:Name>冷却液泄漏风险控制</sysml:Name>
      <sysml:Text>主机冷却水系统应通过管路隔热、安全标识、密封材料选择和泄漏检查等措施减少冷却液泄漏风险。</sysml:Text>
      <sysml:VerifiedBy method="inspection" />
      <sysml:DerivedFrom refId="ER-P029" />
      <sysml:Traceability>
        <Evidence id="E-SUPP-SAFE-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-PUMP-INSP-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-SUPP-MAT-002" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>冷却液泄漏可能导致主机过热、设备损坏及环境污染。</RiskIfUnmet>
        <ApplicabilityConstraint>E-PUMP-INSP-001 基于 Scania DI16 机型，其他机型应参照厂家手册。</ApplicabilityConstraint>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查图纸确认高温冷却水管路（70–95°C）绝热材料耐温≥150°C，表面温度&lt;55°C，不能绝热处贴ISO 11684热警示标识（间距≤2m），管路按ISO 14726色标标识。</Criterion>
        <Criterion>检查冷却液泵泄漏检查程序，确认包含定期检查步骤和修复要求。</Criterion>
        <Criterion>确认乙二醇冷却液系统密封材料选用FKM/PTFE，禁用NBR，机械密封选碳/陶瓷面。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【冷却液泄漏风险控制】，来自原始需求「减少冷却液泄漏」。E-SUPP-SAFE-001 支撑了高温冷却水管路隔热和标识要求；E-PUMP-INSP-001 支撑了冷却液泵泄漏检查要求；E-SUPP-MAT-002 支撑了密封材料相容性要求。</sysml:EngineeringRationale>
      <sysml:QualityGateReport passed="true" score="1.0">
