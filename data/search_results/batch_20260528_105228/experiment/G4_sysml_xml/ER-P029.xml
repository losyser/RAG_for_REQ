    <Requirement id="ER-P029-02" level="1" requirementType="safety">
      <sysml:Name>海水泄漏风险控制</sysml:Name>
      <sysml:Text>主机冷却水系统应通过防腐蚀设计和材料选择减少海水泄漏风险。</sysml:Text>
      <sysml:VerifiedBy method="review" />
      <sysml:DerivedFrom refId="ER-P029" />
      <sysml:Traceability>
        <Evidence id="E-SUPP-ENV-001" supportStatus="supported_by_indirect_evidence" />
        <Evidence id="E-SYS-CORR-004" supportStatus="supported_by_indirect_evidence" />
        <Evidence id="E-SYS-CORR-003" supportStatus="supported_by_indirect_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>supported_by_indirect_evidence</SupportStatus>
        <RiskIfUnmet>海水泄漏可能导致冷却系统腐蚀、设备损坏及海洋污染。</RiskIfUnmet>
        <ApplicabilityConstraint>E-SYS-CORR-004 基于 MAN 49/60DF，E-SYS-CORR-003 基于 Everllence 49/60DF，其他机型应参照厂家资料。</ApplicabilityConstraint>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>确认冷却水系统材料满足防腐蚀要求，具体材料按主机厂家 Technical Data 确认。</Criterion>
        <Criterion>确认膨胀水箱溢流管不排入大海。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【海水泄漏风险控制】，来自原始需求「海水泄漏」。E-SUPP-ENV-001 支撑了冷却水处理化学品环保要求，间接涉及防腐蚀；E-SYS-CORR-004 和 E-SYS-CORR-003 支撑了防腐蚀和环保要求，但受限于厂家机型。</sysml:EngineeringRationale>
