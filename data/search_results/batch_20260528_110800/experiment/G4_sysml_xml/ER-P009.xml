<RequirementSet xmlns:sysml="http://www.omg.org/spec/SysML/20181001/CoolingRAG/Requirements" setId="ER-P009" sourceRequirementId="P009" stakeholder="设备采购方" generationBasis="original_requirement_and_supported_evidence_only" generatedAt="2026-05-28T11:16:18">
  <ProfessionalSummary>覆盖冷却水泵、冷却器、温控阀等关键设备选型应满足主机厂家、船级社和项目技术规格书要求。</ProfessionalSummary>
  <EngineeringRequirements count="1">
    <Requirement id="ER-P009-01" level="1" requirementType="compliance">
      <sysml:Name>关键设备选型合规性</sysml:Name>
      <sysml:Text>冷却水泵、冷却器、温控阀等关键设备的选型应满足主机厂家、船级社和项目技术规格书的要求。</sysml:Text>
      <sysml:VerifiedBy method="review" />
      <sysml:DerivedFrom refId="ER-P009" />
      <sysml:Traceability>
        <Evidence id="E-CCS-COOL-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-IACS-M3-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-DNV-COOL-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-SOLAS-COOL-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>选型不合规可能导致船级社退审、系统性能不达标、主机冷却不足，影响航行安全。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>审查设备选型计算书和规格书，确认冷却水泵台数、容量、驱动方式符合CCS/IACS/SOLAS要求。</Criterion>
        <Criterion>审查温控阀选型，确认其温度控制范围满足DNV规则及主机厂家限值。</Criterion>
        <Criterion>审查冷却器选型，确认其换热容量满足主机额定工况要求。</Criterion>
        <Criterion>所有选型文件应经船级社审批。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【关键设备选型合规性】，来自原始需求「选型应满足主机厂家、船级社和项目技术规格书要求」。E-CCS-COOL-001 支撑了冷却水泵容量和冗余的船级社要求；E-IACS-M3-001 支撑了冷却水泵数量和容量的IACS要求；E-DNV-COOL-001 支撑了温控阀温度控制的船级社要求；E-SOLAS-COOL-001 支撑了冷却系统冗余和报警的SOLAS要求。</sysml:EngineeringRationale>
