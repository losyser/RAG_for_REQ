  <EngineeringRequirements count="3">
    <Requirement id="ER-P065-01" level="1" requirementType="monitoring">
      <sysml:Name>传感器与执行器状态监测</sysml:Name>
      <sysml:Text>主机冷却水系统应配置传感器和执行器状态监测功能，实时监测冷却水温度、压力、液位及泵运行状态等参数，并在参数异常时触发报警。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P065" />
      <sysml:Traceability>
        <Evidence id="E-CTRL-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-IACS-M3-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-CCS-COOL-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>无法实时监测关键参数，故障发现滞后可能导致主机损坏。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查监控系统设计图纸，确认温度、压力、液位、泵状态等参数已纳入监测范围。</Criterion>
        <Criterion>调试期间模拟各参数超限，确认报警信号正确触发并显示。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【传感器与执行器状态监测】，来自原始需求「实时监测传感器和执行器状态」。E-CTRL-COOL-002 支撑了UMS监控参数清单（温度、压力、液位、泵状态）；E-IACS-M3-002 支撑了持续监控温度要求；E-CCS-COOL-001 支撑了高温报警设置。</sysml:EngineeringRationale>
