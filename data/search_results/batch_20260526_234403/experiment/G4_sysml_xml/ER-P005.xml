  <EngineeringRequirements count="1">
    <Requirement id="ER-P005-01" level="1" requirementType="configuration">
      <sysml:Name>冷却水回路划分</sysml:Name>
      <sysml:Text>主机冷却水系统应设计为高温冷却水回路、低温冷却水回路和海水侧边界三个独立部分，并明确各回路的边界和接口。</sysml:Text>
      <sysml:VerifiedBy method="review" />
      <sysml:DerivedFrom refId="ER-P005" />
      <sysml:Traceability>
        <Evidence id="E-CCS-COOL-001" supportStatus="evidence_gap" />
        <Evidence id="E-DNV-COOL-001" supportStatus="evidence_gap" />
        <Evidence id="E-SOLAS-COOL-001" supportStatus="evidence_gap" />
        <Evidence id="E-LT-CAP-001" supportStatus="evidence_gap" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>evidence_gap</SupportStatus>
        <RiskIfUnmet>回路划分不明确可能导致系统设计混乱，影响冷却效果和故障隔离。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>待补充相关工程证据后方可确认验收判据</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【冷却水回路划分】，来自原始需求「明确区分高温冷却水回路、低温冷却水回路和海水侧边界」。E-CCS-COOL-001 间接支撑了HT和LT回路的存在；E-DNV-COOL-001 间接支撑了HT和LT回路温度设计要求；E-SOLAS-COOL-001 间接支撑了冷却系统冗余和报警；E-LT-CAP-001 间接支撑了LT回路容量设计。但均未直接要求回路划分为三个独立部分，故为evidence_gap。</sysml:EngineeringRationale>
