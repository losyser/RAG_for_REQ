        <Check dimension="ambiguity" passed="true" severity="warning">
          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 5 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P072-02" level="1" requirementType="maintainability">
      <sysml:Name>冷却水泵机械密封可更换性</sysml:Name>
      <sysml:Text>冷却水泵应设计专用工具接口，以便于现场操作机械密封的更换。</sysml:Text>
      <sysml:VerifiedBy method="inspection" />
      <sysml:DerivedFrom refId="ER-P072" />
      <sysml:Traceability>
        <Evidence id="E-SUPP-MAINT-002" supportStatus="need_confirmation" />
        <Evidence id="E-PUMP-MAINT-001" supportStatus="need_confirmation" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>need_confirmation</SupportStatus>
        <RiskIfUnmet>无专用工具接口可能导致现场操作困难，增加维修时间和风险。</RiskIfUnmet>
        <ApplicabilityConstraint>具体接口形式和尺寸按主机厂家 Technical Data 确认。</ApplicabilityConstraint>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查泵的供应商图纸，确认设有专用工具接口（如拉马螺纹孔、导向槽等）。</Criterion>
        <Criterion>现场操作验证：使用专用工具进行机械密封更换，确认操作便捷。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【冷却水泵机械密封可更换性】，来自原始需求「设计专用工具接口以便于现场操作」。E-SUPP-MAINT-002 提及模块化快拆设计，但未明确专用工具接口；E-PUMP-MAINT-001（Caterpillar）提到泵应易于拆卸，但未涉及工具接口。因此需厂家确认。</sysml:EngineeringRationale>
