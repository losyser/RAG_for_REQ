          <Message>All 5 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P001-02" level="1" requirementType="redundancy">
      <sysml:Name>冷却水泵冗余配置</sysml:Name>
      <sysml:Text>主机冷却水系统应配置不少于两台冷却水泵，一用一备；任意单台泵发生故障时，备用泵应能自动启动并维持主机冷却水循环不中断。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P001" />
      <sysml:Traceability>
        <Evidence id="E-CCS-COOL-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-DNV-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-IACS-M3-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-SOLAS-COOL-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-PUMP-RED-004" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>单泵故障后无备用将导致冷却中断，主机停机。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查系统图纸，确认泵的台数和备用切换回路配置符合本条要求。</Criterion>
        <Criterion>调试期间模拟主泵故障，确认备用泵自动启动并维持冷却水循环，切换时间按项目调试大纲确认。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【冷却水泵冗余配置】，来自原始需求「冷却水循环中断」。E-CCS-COOL-001、E-DNV-COOL-002、E-IACS-M3-001、E-SOLAS-COOL-001、E-PUMP-RED-004 均支撑了冷却水泵冗余配置和自动切换要求。</sysml:EngineeringRationale>
