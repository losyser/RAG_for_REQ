  <ProfessionalSummary>覆盖主机冷却水系统可靠性要求，包含冷却能力、冗余配置和温度控制。</ProfessionalSummary>
  <EngineeringRequirements count="4">
    <Requirement id="ER-P001-01" level="1" requirementType="reliability">
      <sysml:Name>冷却系统整体可靠性</sysml:Name>
      <sysml:Text>主机冷却水系统应设计为在正常工况下具备充足的冷却能力，确保主机在所有运行工况下冷却水温度不超过主机厂家规定的最高允许值。</sysml:Text>
      <sysml:VerifiedBy method="calculation" />
      <sysml:DerivedFrom refId="ER-P001" />
      <sysml:Traceability>
        <Evidence id="E-CCS-COOL-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-IACS-M3-003" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>冷却能力不足将导致主机过热，影响推进装置安全运行。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>审查冷却系统热平衡计算书，确认冷却能力满足主机MCR工况及最高海水温度下的散热需求。</Criterion>
        <Criterion>冷却水泵总容量余量按主机厂家Technical Data确认。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【冷却系统整体可靠性】，来自原始需求「较高运行可靠性」。E-CCS-COOL-001 支撑了冷却系统按最高海水温度设计的要求；E-IACS-M3-003 支撑了冷却水泵总容量余量≥25%的要求。</sysml:EngineeringRationale>
