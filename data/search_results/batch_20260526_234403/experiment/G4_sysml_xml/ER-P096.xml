<RequirementSet xmlns:sysml="http://www.omg.org/spec/SysML/20181001/CoolingRAG/Requirements" setId="ER-P096" sourceRequirementId="P096" stakeholder="船厂质量检验人员" generationBasis="original_requirement_and_supported_evidence_only" generatedAt="2026-05-27T00:31:15">
  <ProfessionalSummary>覆盖冷却水系统管路焊缝无损检测要求，包括检测比例、方法、验收标准和报告提交。</ProfessionalSummary>
  <EngineeringRequirements count="1">
    <Requirement id="ER-P096-01" level="1" requirementType="test">
      <sysml:Name>管路焊缝无损检测</sysml:Name>
      <sysml:Text>冷却水系统管路焊接完成后，应按比例进行无损检测（如射线或超声波探伤），确保焊缝质量符合船级社规范，并提供检测报告。</sysml:Text>
      <sysml:VerifiedBy method="class_approval" />
      <sysml:DerivedFrom refId="ER-P096" />
      <sysml:Traceability>
        <Evidence id="E-SUPP-WELD-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-SUPP-WELD-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-IACS-M72-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-CCS-COOL-002" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>焊缝缺陷未检出可能导致管路泄漏或破裂，影响主机冷却系统安全运行。</RiskIfUnmet>
        <ApplicabilityConstraint>本条需求基于CCS规范和IACS UR W7/W28/M72，适用于入级CCS的船舶，其他船级社应参照相应规范。</ApplicabilityConstraint>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>DN≥80mm的高压冷却水管路焊缝应进行不少于10%的随机射线或超声波探伤，检测结果应符合船级社规范要求。</Criterion>
        <Criterion>全部焊缝应进行100%外观检验，无裂纹、气孔、未熔合等缺陷。</Criterion>
        <Criterion>管路安装后应进行1.5倍设计压力的水压试验，保压时间不少于30分钟，无泄漏。</Criterion>
        <Criterion>无损检测报告、外观检验记录和水压试验报告应提交验船师审核。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【管路焊缝无损检测】，来自原始需求「应按比例进行无损检测（如射线或超声波探伤），确保焊缝质量符合船级社规范，并提供检测报告」。E-SUPP-WELD-002（CCS规范）和E-SUPP-WELD-001（IACS UR W7/W28）直接支撑了无损检测比例、方法和验收要求；E-IACS-M72-001支撑了水压试验作为焊缝质量验证的补充；E-CCS-COOL-002间接支撑了水压试验要求。</sysml:EngineeringRationale>
