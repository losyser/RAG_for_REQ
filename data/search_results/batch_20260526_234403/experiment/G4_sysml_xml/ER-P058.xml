        <Check dimension="ambiguity" passed="true" severity="warning">
          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 5 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P058-02" level="1" requirementType="control">
      <sysml:Name>膨胀水箱自动补水控制</sysml:Name>
      <sysml:Text>膨胀水箱应配置自动补水装置，当液位低于设定值时，应能自动开启补水阀向水箱补水，直至液位恢复至正常范围。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P058" />
      <sysml:Traceability>
        <Evidence id="E-EXP-ALARM-008" supportStatus="supported_by_indirect_evidence" />
        <Evidence id="E-EXP-ALARM-005" supportStatus="supported_by_indirect_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>supported_by_indirect_evidence</SupportStatus>
        <RiskIfUnmet>无自动补水将导致泄漏后系统失压，需人工干预，增加操作风险。</RiskIfUnmet>
        <ApplicabilityConstraint>自动补水控制逻辑和设定值按主机厂家 Technical Data 确认。</ApplicabilityConstraint>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查图纸确认自动补水阀及控制回路配置符合本条要求。</Criterion>
        <Criterion>调试期间模拟低液位，确认自动补水阀开启并补水至正常液位后关闭。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【膨胀水箱自动补水控制】，来自原始需求「自动补水功能」。E-EXP-ALARM-008（Everllence 49/60DF Project Guide）间接支撑了低液位报警开关的存在，但未明确自动补水控制逻辑；E-EXP-ALARM-005（MAN L23/30H Project Guide）间接支撑了压力维持，但未直接涉及自动补水。</sysml:EngineeringRationale>
