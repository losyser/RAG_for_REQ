          <Message>Evidence present: 5 item(s), support_status='verified_by_direct_evidence'.</Message>
        </Check>
        <Check dimension="verifiability" passed="true" severity="error">
          <Message>Verifiable: method='commissioning_check', 2 criterion/criteria defined.</Message>
        </Check>
        <Check dimension="over_inference" passed="true" severity="error">
          <Message>No over-inference detected.</Message>
        </Check>
        <Check dimension="ambiguity" passed="true" severity="warning">
          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 5 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P033-02" level="1" requirementType="monitoring">
      <sysml:Name>集控室远程监测报警</sysml:Name>
      <sysml:Text>冷却水流量、压力和温度监测信号应接入集控室监控系统，实现远程显示和声光报警功能。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P033" />
      <sysml:Traceability>
        <Evidence id="E-ISO8861-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-CTRL-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-SOLAS-COOL-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>操作人员无法远程监控，增加值班负担，延误故障处理。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查监控系统图纸，确认信号接入点及报警显示功能。</Criterion>
        <Criterion>调试期间验证集控室显示值与现场仪表读数一致，报警功能正常。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【集控室远程监测报警】，来自原始需求「在集控室提供远程显示和报警功能」。E-ISO8861-002（ISO 8861:1998）明确要求所有报警应在机控室和驾驶台显示；E-CTRL-COOL-002（IACS UR E10）要求所有报警接入船舶报警管理系统；E-SOLAS-COOL-001（SOLAS Reg.26）要求温度异常时报警并在集控室显示。</sysml:EngineeringRationale>
