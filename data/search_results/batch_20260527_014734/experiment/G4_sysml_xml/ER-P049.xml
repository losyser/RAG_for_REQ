  <ProfessionalSummary>覆盖膨胀水柜安装高度及仪表报警接口要求，确保系统静压、排气及安全监控。</ProfessionalSummary>
  <EngineeringRequirements count="2">
    <Requirement id="ER-P049-01" level="1" requirementType="installation">
      <sysml:Name>膨胀水柜安装高度</sysml:Name>
      <sysml:Text>膨胀水柜的安装位置应高于主发动机冷却水系统最高点至少1米，以保证系统静压和排气。</sysml:Text>
      <sysml:VerifiedBy method="inspection" />
      <sysml:DerivedFrom refId="ER-P049" />
      <sysml:Traceability>
        <Evidence id="E-EXP-CAP-001" supportStatus="need_confirmation" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>need_confirmation</SupportStatus>
        <RiskIfUnmet>安装高度不足可能导致系统静压不够，影响排气和冷却水循环，甚至引起气蚀。</RiskIfUnmet>
        <ApplicabilityConstraint>具体高度值1米来自原始需求，证据未提供其他限值，需结合厂家要求确认。</ApplicabilityConstraint>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查安装图纸，确认膨胀水柜底部（或最低液位）与主发动机冷却水系统最高点的高差≥1米。</Criterion>
        <Criterion>现场安装后测量实际高差并记录，确认满足设计要求。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【膨胀水柜安装高度】，来自原始需求「安装位置应高于主发动机最高点至少1米」。E-EXP-CAP-001（DNV规则）支撑了膨胀水箱应位于回路最高点的要求，但未明确具体高度值。</sysml:EngineeringRationale>
      <sysml:QualityGateReport passed="true" score="1.0">
        <Check dimension="evidence_sufficiency" passed="true" severity="error">
          <Message>Evidence present: 1 item(s), support_status='need_confirmation'.</Message>
        </Check>
        <Check dimension="verifiability" passed="true" severity="error">
          <Message>Verifiable: method='inspection', 2 criterion/criteria defined.</Message>
        </Check>
        <Check dimension="over_inference" passed="true" severity="error">
          <Message>No over-inference detected.</Message>
        </Check>
        <Check dimension="ambiguity" passed="true" severity="warning">
          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 5 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P049-02" level="1" requirementType="configuration">
      <sysml:Name>膨胀水柜仪表与报警接口</sysml:Name>
      <sysml:Text>膨胀水柜应配置液位计和低液位报警接口，液位计应便于观察，低液位报警信号应接入集控室监控系统。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P049" />
      <sysml:Traceability>
        <Evidence id="E-EXP-CAP-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-CTRL-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-ISO8861-002" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>缺少液位计或低液位报警将无法及时发现冷却水泄漏，可能导致主机冷却中断。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查图纸确认液位计和低液位报警接口的配置。</Criterion>
        <Criterion>调试时模拟低液位，确认报警信号在集控室和驾驶台正确显示。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【膨胀水柜仪表与报警接口】，来自原始需求「柜体需设液位计和低液位报警接口」。E-EXP-CAP-001（DNV规则）要求装设液位计和低液位报警；E-CTRL-COOL-002（IACS UR E10）和E-ISO8861-002（ISO 8861）均要求膨胀水箱低液位报警并接入报警系统。</sysml:EngineeringRationale>
