  <ProfessionalSummary>覆盖主机冷却水系统调试验证要求，包括泵组运行、阀门动作、温控调节、报警触发和主要冷却用户参数响应。</ProfessionalSummary>
  <EngineeringRequirements count="1">
    <Requirement id="ER-P020-01" level="1" requirementType="commissioning_check">
      <sysml:Name>冷却水系统调试验证</sysml:Name>
      <sysml:Text>主机冷却水系统调试时应验证泵组运行、阀门动作、温控调节、报警触发和主要冷却用户参数响应。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P020" />
      <sysml:Traceability>
        <Evidence id="E-CCS-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-COMM-COOL-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-IACS-M51-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-SUPP-COMM-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>调试验证不充分可能导致系统隐患未发现，影响航行安全。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>调试前完成管路/阀门/膨胀水箱/冷却液/排气/泵/传感器/报警/TCV/备用泵自动启动/冲洗/保温标识等检查项，并提交联签清单。</Criterion>
        <Criterion>调试期间验证泵组运行（转向、流量、备用泵自动切换）、阀门动作（开闭、调节）、温控阀调节功能、报警触发（高温、低液位等）和主要冷却用户参数响应（温度、压力）。</Criterion>
        <Criterion>系泊试验和航行试验中验证系统稳定性，MCR工况下持续运行时间按项目调试大纲或厂家试验程序确认。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【冷却水系统调试验证】，来自原始需求「验证泵组运行、阀门动作、温控调节、报警触发和主要冷却用户参数响应」。E-CCS-COOL-002 支撑了功能试验覆盖泵、阀、温控阀、报警的要求；E-COMM-COOL-001 支撑了泵转向、温控阀功能、报警触发等验证；E-IACS-M51-001 支撑了报警和跳闸功能验证；E-SUPP-COMM-001 支撑了调试前核查清单包含泵、阀门、传感器、报警等检查项。</sysml:EngineeringRationale>
