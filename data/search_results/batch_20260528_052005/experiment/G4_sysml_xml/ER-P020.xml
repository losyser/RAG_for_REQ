<RequirementSet xmlns:sysml="http://www.omg.org/spec/SysML/20181001/CoolingRAG/Requirements" setId="ER-P020" sourceRequirementId="P020" stakeholder="调试人员" generationBasis="original_requirement_and_supported_evidence_only" generatedAt="2026-05-28T05:28:53">
  <ProfessionalSummary>覆盖冷却水系统调试验证要求，包括泵组运行、阀门动作、温控调节、报警触发和主要冷却用户参数响应验证。</ProfessionalSummary>
  <EngineeringRequirements count="4">
    <Requirement id="ER-P020-01" level="1" requirementType="commissioning_check">
      <sysml:Name>泵组运行验证</sysml:Name>
      <sysml:Text>冷却水系统调试时应验证所有冷却水泵的启动、运行和备用泵自动切换功能。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P020" />
      <sysml:Traceability>
        <Evidence id="E-CCS-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-COMM-COOL-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-IACS-M51-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>泵组故障无法及时切换可能导致主机冷却中断，影响航行安全。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查调试记录，确认每台泵均能正常启动并运行，旋转方向正确，压力和流量满足系统要求。</Criterion>
        <Criterion>模拟主泵故障，确认备用泵自动启动并维持系统正常运行，切换时间按项目调试大纲确认。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【泵组运行验证】，来自原始需求「验证泵组运行」。E-CCS-COOL-002（CCS规则）支撑了泵组功能试验要求；E-COMM-COOL-001（综合规范程序）支撑了启动、运行和切换验证步骤；E-IACS-M51-001（IACS UR M51）支撑了船上试验中辅助系统兼容性验证。</sysml:EngineeringRationale>
      <sysml:QualityGateReport passed="true" score="1.0">
        <Check dimension="evidence_sufficiency" passed="true" severity="error">
          <Message>Evidence present: 3 item(s), support_status='verified_by_direct_evidence'.</Message>
        </Check>
        <Check dimension="verifiability" passed="true" severity="error">
          <Message>Verifiable: method='commissioning_check', 2 criterion/criteria defined.</Message>
        </Check>
        <Check dimension="over_inference" passed="true" severity="error">
          <Message>No over-inference detected.</Message>
        </Check>
        <Check dimension="ambiguity" passed="true" severity="warning">
          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 4 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P020-02" level="1" requirementType="commissioning_check">
      <sysml:Name>阀门动作验证</sysml:Name>
      <sysml:Text>冷却水系统调试时应验证各阀门（包括调节阀、截止阀等）的动作正确性和响应时间。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P020" />
      <sysml:QualityStatus>
        <SupportStatus>evidence_gap</SupportStatus>
        <RiskIfUnmet>阀门动作异常可能导致冷却水流量分配错误或温控失效。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>待补充相关工程证据后方可确认验收判据。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【阀门动作验证】，来自原始需求「阀门动作」。E-CCS-COOL-002（CCS规则）支撑了阀件功能试验要求；E-SUPP-COMM-001（调试前核查清单）间接支撑了阀门检查项。</sysml:EngineeringRationale>
