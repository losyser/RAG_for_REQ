          <Message>Evidence present: 2 item(s), support_status='verified_by_direct_evidence'.</Message>
        </Check>
        <Check dimension="verifiability" passed="true" severity="error">
          <Message>Verifiable: method='inspection', 2 criterion/criteria defined.</Message>
        </Check>
        <Check dimension="over_inference" passed="true" severity="error">
          <Message>No over-inference detected.</Message>
        </Check>
        <Check dimension="ambiguity" passed="true" severity="warning">
          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 4 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P042-03" level="1" requirementType="function">
      <sysml:Name>系统压力稳定控制</sysml:Name>
      <sysml:Text>膨胀水箱应通过维持正常液位范围来稳定系统压力，防止因容积波动导致压力过高或过低。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P042" />
      <sysml:Traceability>
        <Evidence id="E-EXP-CAP-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-SUPP-COMM-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>压力波动可能导致主机冷却水循环中断或设备损坏。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查设计计算书确认膨胀水箱容积满足DNV规则要求。</Criterion>
        <Criterion>调试期间确认液位在50-75%范围内，系统压力稳定。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【系统压力稳定控制】，来自原始需求「维持系统压力稳定」。E-EXP-CAP-001（DNV规则）要求膨胀水箱容积≥回路总水量的5%以吸收容积波动；E-SUPP-COMM-001（调试清单）要求液位在50-75%范围内。</sysml:EngineeringRationale>
