          <Message>Verifiable: method='commissioning_check', 2 criterion/criteria defined.</Message>
        </Check>
        <Check dimension="over_inference" passed="true" severity="error">
          <Message>No over-inference detected.</Message>
        </Check>
        <Check dimension="ambiguity" passed="true" severity="warning">
          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 4 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P042-02" level="1" requirementType="function">
      <sysml:Name>膨胀水箱排气功能</sysml:Name>
      <sysml:Text>膨胀水箱应安装于冷却回路最高点，并设置排气口或排气管，以排出系统中的空气和气体。</sysml:Text>
      <sysml:VerifiedBy method="inspection" />
      <sysml:DerivedFrom refId="ER-P042" />
      <sysml:Traceability>
        <Evidence id="E-EXP-CAP-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-EXP-MAINT-003" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>系统内气体无法排出将导致冷却效率下降、气蚀及压力波动。</RiskIfUnmet>
        <ApplicabilityConstraint>E-EXP-MAINT-003 基于 Wärtsilä 32 产品指南，适用范围限于该厂家机型，其他厂家应参照各自技术文件。</ApplicabilityConstraint>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查安装图纸确认膨胀水箱位于回路最高点，排气口或排气管设置正确。</Criterion>
        <Criterion>现场检查确认排气口无堵塞，管路连接正确。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【膨胀水箱排气功能】，来自原始需求「排气功能」。E-EXP-CAP-001（DNV规则）要求膨胀水箱位于回路最高点以确保自由膨胀和排气；E-EXP-MAINT-003（Wärtsilä产品指南）说明膨胀水箱用于排气。</sysml:EngineeringRationale>
      <sysml:QualityGateReport passed="true" score="1.0">
