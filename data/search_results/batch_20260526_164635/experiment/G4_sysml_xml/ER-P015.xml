  <ProfessionalSummary>覆盖主机冷却水系统报警与保护功能，包括高温、低压、低液位、泵故障等工况的报警与自动保护逻辑。</ProfessionalSummary>
  <EngineeringRequirements count="4">
    <Requirement id="ER-P015-01-01" level="1" requirementType="alarm">
      <sysml:Name>冷却水系统报警与保护功能</sysml:Name>
      <sysml:Text>主机冷却水高温报警应设置三级保护逻辑：第一级报警，第二级自动减速，第三级自动停机；减速触发点应比报警点高3–5°C。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P015" />
      <sysml:Traceability>
        <Evidence id="E-SUPP-LDR-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>缺少自动减速或停机保护可能导致主机在高温下持续运行，造成严重损坏。</RiskIfUnmet>
        <ApplicabilityConstraint>本条需求基于IACS UR E10证据，适用范围限于UMS船舶，其他船型应按船级社规则确认。</ApplicabilityConstraint>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查控制逻辑设计文件，确认三级保护逻辑配置正确。</Criterion>
        <Criterion>调试期间模拟高温工况，验证报警、减速、停机动作顺序正确，具体温度设定值按主机厂家Technical Data确认。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【冷却水系统报警与保护功能】，来自原始需求「冷却水高温…应能被及时发现」。E-SUPP-LDR-001（IACS UR E10）明确给出了高温三级保护逻辑和减速触发点差值。</sysml:EngineeringRationale>
      <sysml:QualityGateReport passed="true" score="1.0">
        <Check dimension="evidence_sufficiency" passed="true" severity="error">
          <Message>Evidence present: 1 item(s), support_status='verified_by_direct_evidence'.</Message>
