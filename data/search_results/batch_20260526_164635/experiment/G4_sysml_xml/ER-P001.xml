<RequirementSet xmlns:sysml="http://www.omg.org/spec/SysML/20181001/CoolingRAG/Requirements" setId="ER-P001" sourceRequirementId="P001" stakeholder="船东代表" generationBasis="original_requirement_and_supported_evidence_only" generatedAt="2026-05-26T17:39:40">
  <ProfessionalSummary>覆盖主机冷却水系统可靠性要求，包含冷却能力、冗余配置和温度控制。</ProfessionalSummary>
  <EngineeringRequirements count="2">
    <Requirement id="ER-P001-01" level="1" requirementType="reliability">
      <sysml:Name>冷却系统整体可靠性</sysml:Name>
      <sysml:Text>主机冷却水系统应配置不少于两台冷却水泵，一用一备，每台泵容量应满足主机额定工况（MCR）下所需全流量；任意单台泵发生故障时，备用泵应能自动启动并维持主机冷却水循环不中断。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P001" />
      <sysml:Traceability>
        <Evidence id="E-CCS-COOL-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-DNV-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-IACS-M3-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-SOLAS-COOL-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>单泵故障后无备用将导致主机冷却中断，影响航行安全。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查图纸确认泵的台数、容量及备用切换回路配置符合本条要求。</Criterion>
        <Criterion>调试期间模拟主泵故障，确认备用泵自动启动并维持冷却水循环，具体切换时间按项目调试大纲确认。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【冷却系统整体可靠性】，来自原始需求「较高运行可靠性，不能因冷却能力不足、冷却水循环中断或温度失控影响推进装置安全运行」。E-CCS-COOL-001（CCS规则）支撑了泵的数量和容量要求；E-DNV-COOL-002（DNV规则）支撑了自动切换要求；E-IACS-M3-001（IACS UR M3.1）支撑了泵的数量和容量要求；E-SOLAS-COOL-001（SOLAS Reg.26）支撑了备用泵自动启动要求。</sysml:EngineeringRationale>
