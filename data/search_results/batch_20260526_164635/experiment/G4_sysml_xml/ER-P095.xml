    <Requirement id="ER-P095-02" level="1" requirementType="maintainability">
      <sysml:Name>维护手册管路图提供</sysml:Name>
      <sysml:Text>维护手册中应提供完整的冷却水管路图，包括管路走向、阀门位置、设备接口、流向标识和编号，并标注维护通道和隔离阀位置，以支持现场快速定位和隔离故障段。</sysml:Text>
      <sysml:VerifiedBy method="review" />
      <sysml:DerivedFrom refId="ER-P095" />
