  <EngineeringRequirements count="2">
    <Requirement id="ER-P095-01" level="1" requirementType="maintainability">
      <sysml:Name>管路阀门标识与编号</sysml:Name>
      <sysml:Text>冷却水管路和阀门应标注流向标识和唯一编号，标识应清晰、耐久，并符合船级社规范要求，便于现场识别和故障隔离。</sysml:Text>
      <sysml:VerifiedBy method="inspection" />
      <sysml:DerivedFrom refId="ER-P095" />
      <sysml:Traceability>
        <Evidence id="E-SUPP-MAINT-001" supportStatus="supported_by_indirect_evidence" />
        <Evidence id="E-SUPP-MAINT-002" supportStatus="supported_by_indirect_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>supported_by_indirect_evidence</SupportStatus>
        <RiskIfUnmet>无标识或标识不清将导致故障时无法快速定位和隔离，延长停机时间。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查图纸和现场，确认所有冷却水管路和阀门均标注流向箭头和唯一编号。</Criterion>
        <Criterion>标识应固定在显眼位置，字体大小和耐久性满足船级社规范要求。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【管路阀门标识与编号】，来自原始需求「标注流向标识和编号」。E-SUPP-MAINT-001 支撑了维护通道间距要求，间接支撑标识便于快速定位；E-SUPP-MAINT-002 支撑了模块化快拆设计，间接支撑标识便于隔离。</sysml:EngineeringRationale>
