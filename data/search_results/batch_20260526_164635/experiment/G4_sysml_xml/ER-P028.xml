<RequirementSet xmlns:sysml="http://www.omg.org/spec/SysML/20181001/CoolingRAG/Requirements" setId="ER-P028" sourceRequirementId="P028" stakeholder="船厂质量检验人员" generationBasis="original_requirement_and_supported_evidence_only" generatedAt="2026-05-26T17:39:40">
  <ProfessionalSummary>覆盖冷却水系统安装后检查要求，包括管路密性试验、支架固定检查、传感器安装检查及交船前整改。</ProfessionalSummary>
  <EngineeringRequirements count="4">
    <Requirement id="ER-P028-01" level="1" requirementType="test">
      <sysml:Name>管路密性检查</sysml:Name>
      <sysml:Text>冷却水系统管路安装完成后，应按设计压力进行水压密性试验，试验压力不低于设计压力的1.5倍，保压时间不少于30分钟，试验过程中管路应无泄漏。</sysml:Text>
      <sysml:VerifiedBy method="test" />
      <sysml:DerivedFrom refId="ER-P028" />
      <sysml:Traceability>
        <Evidence id="E-CCS-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-IACS-M72-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>管路泄漏可能导致冷却水流失、主机过热，影响航行安全。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查水压试验记录，确认试验压力不低于设计压力的1.5倍，保压时间不少于30分钟。</Criterion>
        <Criterion>试验期间管路无可见泄漏，压力降在允许范围内。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【管路密性检查】，来自原始需求「检查管路密性」。E-CCS-COOL-002（CCS规则）支撑了1.5倍设计压力、保压30分钟的要求；E-IACS-M72-001（IACS UR M72）支撑了1.5倍最大工作压力的试验压力要求。</sysml:EngineeringRationale>
      <sysml:QualityGateReport passed="true" score="1.0">
        <Check dimension="evidence_sufficiency" passed="true" severity="error">
          <Message>Evidence present: 2 item(s), support_status='verified_by_direct_evidence'.</Message>
        </Check>
        <Check dimension="verifiability" passed="true" severity="error">
          <Message>Verifiable: method='test', 2 criterion/criteria defined.</Message>
        </Check>
        <Check dimension="over_inference" passed="true" severity="error">
          <Message>No over-inference detected.</Message>
        </Check>
        <Check dimension="ambiguity" passed="true" severity="warning">
          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 5 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P028-02" level="1" requirementType="installation">
      <sysml:Name>支架固定检查</sysml:Name>
      <sysml:Text>冷却水系统管路支架应固定牢固，符合设计要求，确保管路在运行中无异常振动和位移。</sysml:Text>
      <sysml:VerifiedBy method="inspection" />
      <sysml:DerivedFrom refId="ER-P028" />
      <sysml:QualityStatus>
        <SupportStatus>evidence_gap</SupportStatus>
        <RiskIfUnmet>支架固定不牢可能导致管路振动、接头松动，引发泄漏或损坏。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>待补充相关工程证据后方可确认验收判据。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【支架固定检查】，来自原始需求「支架固定」。E-SUPP-MAINT-001（DNV/IACS维护通道间距要求）间接支撑了安装布置要求，但无直接证据规定支架固定细节。</sysml:EngineeringRationale>
