  <EngineeringRequirements count="3">
    <Requirement id="ER-P054-01" level="1" requirementType="monitoring">
      <sysml:Name>冷却水系统监测参数</sysml:Name>
      <sysml:Text>主机冷却水系统应在各支路安装流量计和温度传感器，用于实时监测各支路的流量和温度。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P054" />
      <sysml:Traceability>
        <Evidence id="E-CTRL-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-ISO8861-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-IACS-M3-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-TSENS-PRESS-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>无法实时监测各支路流量和温度，可能导致冷却异常未被及时发现，影响主机安全。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查系统图纸，确认各支路均配置流量计和温度传感器。</Criterion>
        <Criterion>调试期间验证传感器信号正常接入监测系统，具体测量精度和报警值按主机厂家 Technical Data 确认。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【冷却水系统监测参数】，来自原始需求「安装流量计和温度传感器，实时监测各支路流量和温度」。E-CTRL-COOL-002（IACS UR E10）支撑了温度传感器连续监测的要求；E-ISO8861-002（ISO 8861:1998）支撑了温度监测要求；E-IACS-M3-002（IACS UR M3.1）支撑了温度监控要求；E-TSENS-PRESS-001（Wärtsilä 32 Product Guide）间接支撑了温度传感器安装要求。</sysml:EngineeringRationale>
      <sysml:QualityGateReport passed="true" score="1.0">
