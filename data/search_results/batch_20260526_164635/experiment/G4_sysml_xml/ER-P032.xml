  <ProfessionalSummary>覆盖主机冷却水系统闭式循环设计、膨胀水箱功能配置和冷却水水质处理要求。</ProfessionalSummary>
  <EngineeringRequirements count="3">
    <Requirement id="ER-P032-01" level="1" requirementType="configuration">
      <sysml:Name>冷却水系统闭式循环设计</sysml:Name>
      <sysml:Text>主机冷却水系统应采用闭式循环设计，使用经防锈、防垢处理的淡水作为冷却介质。</sysml:Text>
      <sysml:VerifiedBy method="review" />
      <sysml:DerivedFrom refId="ER-P032" />
      <sysml:Traceability>
        <Evidence id="E-CCS-COOL-001" supportStatus="supported_by_indirect_evidence" />
        <Evidence id="E-DNV-COOL-001" supportStatus="supported_by_indirect_evidence" />
        <Evidence id="E-SOLAS-COOL-001" supportStatus="supported_by_indirect_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>supported_by_indirect_evidence</SupportStatus>
        <RiskIfUnmet>开式循环或使用未处理海水可能导致腐蚀、结垢，影响主机冷却效果和寿命。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>审查系统设计图纸，确认冷却水系统为闭式循环，使用淡水作为冷却介质。</Criterion>
        <Criterion>确认系统设计满足船级社规则和主机厂家要求，具体参数按主机厂家 Technical Data 确认。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【冷却水系统闭式循环设计】，来自原始需求「冷却水系统应设计为闭式循环，并采用经防锈、防垢处理的淡水」。E-CCS-COOL-001（CCS规则）间接支撑系统设计需满足特定海水温度条件；E-DNV-COOL-001（DNV规则）间接支撑温度控制要求；E-SOLAS-COOL-001（SOLAS Reg.26）间接支撑冷却系统冗余和报警要求。</sysml:EngineeringRationale>
      <sysml:QualityGateReport passed="true" score="1.0">
