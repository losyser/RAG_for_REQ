    <Requirement id="ER-P013-01" level="1" requirementType="monitoring">
      <sysml:Name>冷却水泵监控接入</sysml:Name>
      <sysml:Text>冷却水泵的运行状态（运行/停止）应接入监控系统，并在集控室和驾驶台显示。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P013" />
      <sysml:Traceability>
        <Evidence id="E-CTRL-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-ISO8861-002" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>无法监控泵运行状态，影响故障判断和操作决策。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查监控系统图纸，确认冷却水泵运行状态信号已接入并显示。</Criterion>
        <Criterion>调试期间验证泵启动/停止时状态显示正确。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【冷却水泵监控接入】，来自原始需求「冷却水泵、温控阀、传感器和必要的流量信号应接入监控系统」。E-CTRL-COOL-002（IACS UR E10）直接支撑了泵运行状态指示要求；E-ISO8861-002（ISO 8861:1998）支撑了报警显示要求。</sysml:EngineeringRationale>
