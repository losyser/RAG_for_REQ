<RequirementSet xmlns:sysml="http://www.omg.org/spec/SysML/20181001/CoolingRAG/Requirements" setId="ER-P098" sourceRequirementId="P098" stakeholder="船厂质量检验人员" generationBasis="original_requirement_and_supported_evidence_only" generatedAt="2026-05-27T01:30:52">
  <ProfessionalSummary>覆盖主机冷却水系统压力试验时的管路及附件变形检查和法兰连接处渗漏检查要求。</ProfessionalSummary>
  <EngineeringRequirements count="2">
    <Requirement id="ER-P098-01" level="1" requirementType="test">
      <sysml:Name>管路及附件压力试验变形检查</sysml:Name>
      <sysml:Text>冷却水系统压力试验时，应逐段检查管路及附件（如膨胀节、阀门）在试验压力下的变形情况，确保无异常变形。</sysml:Text>
      <sysml:VerifiedBy method="inspection" />
      <sysml:DerivedFrom refId="ER-P098" />
      <sysml:Traceability>
        <Evidence id="E-CCS-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-SUPP-WELD-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-SUPP-WELD-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-IACS-M72-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>管路或附件在试验压力下发生变形而未发现，可能导致运行中泄漏或破裂，危及系统安全。</RiskIfUnmet>
        <ApplicabilityConstraint>本条需求基于CCS、IACS等船级社规则证据，适用范围限于入级该等船级社的船舶；其他船级社应按其规则确认。</ApplicabilityConstraint>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>试验过程中逐段目视检查管路及附件，无可见变形。</Criterion>
        <Criterion>试验压力按船级社规则或项目试验程序确认，保压时间按项目调试大纲要求。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【管路及附件压力试验变形检查】，来自原始需求「应逐段检查管路及附件（如膨胀节、阀门）在试验压力下的变形情况」。E-CCS-COOL-002、E-SUPP-WELD-002、E-SUPP-WELD-001、E-IACS-M72-001均要求水压试验保压期间不得有渗漏或变形，支撑了变形检查要求。</sysml:EngineeringRationale>
      <sysml:QualityGateReport passed="true" score="0.8">
        <Check dimension="evidence_sufficiency" passed="true" severity="error">
