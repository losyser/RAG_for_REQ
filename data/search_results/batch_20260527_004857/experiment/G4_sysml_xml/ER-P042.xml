<RequirementSet xmlns:sysml="http://www.omg.org/spec/SysML/20181001/CoolingRAG/Requirements" setId="ER-P042" sourceRequirementId="P042" stakeholder="系统设计方" generationBasis="original_requirement_and_supported_evidence_only" generatedAt="2026-05-27T01:30:52">
  <ProfessionalSummary>覆盖主机冷却水系统膨胀水箱的自动补水、排气、压力稳定及容积补偿功能要求。</ProfessionalSummary>
  <EngineeringRequirements count="4">
    <Requirement id="ER-P042-01" level="1" requirementType="function">
      <sysml:Name>膨胀水箱自动补水功能</sysml:Name>
      <sysml:Text>膨胀水箱应配置自动补水装置，当液位低于设定值时自动启动补水，并设置低液位报警。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P042" />
      <sysml:Traceability>
        <Evidence id="E-EXP-CAP-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-CTRL-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-ISO8861-002" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>无法自动补水将导致膨胀水箱液位过低，系统压力波动，可能引起主机冷却中断。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查图纸确认自动补水阀及低液位报警配置符合本条要求。</Criterion>
        <Criterion>调试期间模拟低液位，确认自动补水启动并发出报警，具体液位设定值按主机厂家Technical Data确认。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【膨胀水箱自动补水功能】，来自原始需求「自动补水功能」。E-EXP-CAP-001（DNV规则）支撑了低液位报警和填充接口要求；E-CTRL-COOL-002（IACS UR E10）和E-ISO8861-002（ISO 8861）均要求膨胀水箱低液位监测和报警，间接支撑自动补水功能。</sysml:EngineeringRationale>
      <sysml:QualityGateReport passed="true" score="1.0">
        <Check dimension="evidence_sufficiency" passed="true" severity="error">
          <Message>Evidence present: 3 item(s), support_status='verified_by_direct_evidence'.</Message>
        </Check>
        <Check dimension="verifiability" passed="true" severity="error">
          <Message>Verifiable: method='commissioning_check', 2 criterion/criteria defined.</Message>
        </Check>
        <Check dimension="over_inference" passed="true" severity="error">
          <Message>No over-inference detected.</Message>
        </Check>
        <Check dimension="ambiguity" passed="true" severity="warning">
          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 5 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P042-02" level="1" requirementType="function">
      <sysml:Name>膨胀水箱排气功能</sysml:Name>
      <sysml:Text>膨胀水箱应设置排气装置，确保系统运行时能自动排出冷却水中的气体，防止气塞。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P042" />
      <sysml:Traceability>
        <Evidence id="E-EXP-CAP-001" supportStatus="supported_by_indirect_evidence" />
        <Evidence id="E-EXP-ALARM-002" supportStatus="supported_by_indirect_evidence" />
        <Evidence id="E-EXP-ALARM-004" supportStatus="supported_by_indirect_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>supported_by_indirect_evidence</SupportStatus>
        <RiskIfUnmet>气体无法排出将导致冷却水循环不畅，局部过热，影响主机冷却效果。</RiskIfUnmet>
        <ApplicabilityConstraint>E-EXP-ALARM-002和E-EXP-ALARM-004基于MAN L23/30DF和L23/30H机型，其他厂家和机型应按各自Technical Data确认。</ApplicabilityConstraint>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查图纸确认膨胀水箱位于回路最高点并设有排气接口或自动排气阀。</Criterion>
        <Criterion>调试期间确认系统运行后无气体聚集，具体排气方式按主机厂家Technical Data确认。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【膨胀水箱排气功能】，来自原始需求「排气功能」。E-EXP-CAP-001（DNV规则）要求膨胀水箱位于回路最高点以确保自由膨胀和排气，间接支撑排气功能；E-EXP-ALARM-002和E-EXP-ALARM-004（MAN项目指南）描述了脱气箱与膨胀水箱之间的报警装置，间接支撑排气功能监测。</sysml:EngineeringRationale>
      <sysml:QualityGateReport passed="true" score="1.0">
        <Check dimension="evidence_sufficiency" passed="true" severity="error">
          <Message>Evidence present: 3 item(s), support_status='supported_by_indirect_evidence'.</Message>
        </Check>
        <Check dimension="verifiability" passed="true" severity="error">
          <Message>Verifiable: method='commissioning_check', 2 criterion/criteria defined.</Message>
        </Check>
        <Check dimension="over_inference" passed="true" severity="error">
          <Message>No over-inference detected.</Message>
        </Check>
        <Check dimension="ambiguity" passed="true" severity="warning">
          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 5 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P042-03" level="1" requirementType="function">
      <sysml:Name>系统压力稳定控制</sysml:Name>
      <sysml:Text>膨胀水箱应通过自动补水和排气功能维持系统压力在主机厂家规定的范围内，防止压力波动过大。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P042" />
      <sysml:Traceability>
        <Evidence id="E-EXP-CAP-001" supportStatus="supported_by_indirect_evidence" />
        <Evidence id="E-SOLAS-INCL-001" supportStatus="supported_by_indirect_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>supported_by_indirect_evidence</SupportStatus>
        <RiskIfUnmet>压力波动过大可能导致主机冷却水系统故障，影响主机运行安全。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查图纸确认膨胀水箱容积和安装高度满足压力稳定要求。</Criterion>
        <Criterion>调试期间监测系统压力波动，确认在主机厂家Technical Data规定的范围内。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【系统压力稳定控制】，来自原始需求「维持系统压力稳定」。E-EXP-CAP-001（DNV规则）要求膨胀水箱容积满足自由膨胀和排气，间接支撑压力稳定；E-SOLAS-INCL-001（SOLAS Reg.26）要求膨胀水箱在倾斜工况下维持足够液位，间接支撑压力稳定。</sysml:EngineeringRationale>
      <sysml:QualityGateReport passed="true" score="1.0">
        <Check dimension="evidence_sufficiency" passed="true" severity="error">
          <Message>Evidence present: 2 item(s), support_status='supported_by_indirect_evidence'.</Message>
        </Check>
        <Check dimension="verifiability" passed="true" severity="error">
          <Message>Verifiable: method='commissioning_check', 2 criterion/criteria defined.</Message>
        </Check>
        <Check dimension="over_inference" passed="true" severity="error">
          <Message>No over-inference detected.</Message>
        </Check>
        <Check dimension="ambiguity" passed="true" severity="warning">
          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 5 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P042-04" level="1" requirementType="capacity">
      <sysml:Name>膨胀水箱容积补偿能力</sysml:Name>
      <sysml:Text>膨胀水箱的有效容积应能补偿管路泄漏和温度变化引起的冷却水容积波动，并满足船级社规则要求。</sysml:Text>
      <sysml:VerifiedBy method="calculation" />
      <sysml:DerivedFrom refId="ER-P042" />
      <sysml:Traceability>
        <Evidence id="E-EXP-CAP-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>容积不足将无法补偿容积波动，导致系统压力异常或冷却水溢流。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查图纸确认膨胀水箱有效容积不小于回路总水量的5%（或按主机厂家Technical Data确认）。</Criterion>
        <Criterion>计算书应验证容积补偿能力满足温度变化和泄漏补偿需求。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【膨胀水箱容积补偿能力】，来自原始需求「补偿管路泄漏和温度变化引起的容积波动」。E-EXP-CAP-001（DNV规则）要求膨胀水箱容积≥回路总水量的5%（或厂家规定取大值），直接支撑容积补偿能力。</sysml:EngineeringRationale>
