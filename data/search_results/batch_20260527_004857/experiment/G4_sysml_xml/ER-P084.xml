          <Message>All 5 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P084-02" level="1" requirementType="alarm_protection">
      <sysml:Name>膨胀水箱低液位报警</sysml:Name>
      <sysml:Text>膨胀水箱应设置低液位报警，报警点应位于水箱有效容积的20%处，报警信号应接入集控室监控系统。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P084" />
      <sysml:Traceability>
        <Evidence id="E-EXP-CAP-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-CTRL-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-ISO8861-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-EXP-ALARM-008" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>无低液位报警或报警点不当可能导致冷却水不足未被及时发现，引起主机过热损坏。</RiskIfUnmet>
        <ApplicabilityConstraint>E-EXP-ALARM-008 基于Everllence 49/60DF项目指南，其他厂家和机型应参照各自Technical Data确认报警点设置。</ApplicabilityConstraint>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查设计图纸，确认低液位报警设定点为有效容积的20%。</Criterion>
        <Criterion>调试期间模拟低液位，确认报警信号正确触发并传输至集控室。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【膨胀水箱低液位报警】，来自原始需求「设置低液位报警，报警点应位于水箱有效容积的20%处」。E-EXP-CAP-001（DNV规则）支撑低液位报警要求；E-CTRL-COOL-002（IACS UR E10）和E-ISO8861-002（ISO 8861）均要求膨胀水箱低液位报警；E-EXP-ALARM-008（厂家项目指南）支撑配备低液位报警开关。</sysml:EngineeringRationale>
