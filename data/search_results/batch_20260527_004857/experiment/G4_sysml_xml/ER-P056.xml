        </Check>
        <Check dimension="over_inference" passed="true" severity="error">
          <Message>No over-inference detected.</Message>
        </Check>
        <Check dimension="ambiguity" passed="true" severity="warning">
          <Message>No ambiguous terms detected (LLM check).</Message>
        </Check>
        <Check dimension="mbse_completeness" passed="true" severity="error">
          <Message>All 5 SysML required fields are present.</Message>
        </Check>
      </sysml:QualityGateReport>
    </Requirement>
    <Requirement id="ER-P056-02" level="1" requirementType="capacity">
      <sysml:Name>热带海域适应性</sysml:Name>
      <sysml:Text>中央冷却系统应按照热带海域最高海水温度不低于35°C进行设计，确保在生物附着条件下仍能维持主机及辅助设备在最大持续功率（MCR）工况下的冷却要求。</sysml:Text>
      <sysml:VerifiedBy method="calculation" />
      <sysml:DerivedFrom refId="ER-P056" />
      <sysml:Traceability>
        <Evidence id="E-LT-CAP-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-CCS-COOL-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-ISO8861-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>设计温度不足将导致热带海域冷却能力下降，影响主机运行。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>审查设计计算书确认设计海水温度不低于35°C。</Criterion>
        <Criterion>审查换热器容量计算确认净冷却能力余量≥15%。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【热带海域适应性】，来自原始需求「应对热带海域生物附着问题」。E-LT-CAP-001（DNV规则）要求设计海水温度热带≥35°C；E-CCS-COOL-001（CCS规则）要求系统按热带35°C设计；E-ISO8861-001（ISO标准）要求冷却系统在最高海水温度下维持性能，并考虑污垢余量≥15%。</sysml:EngineeringRationale>
