<RequirementSet xmlns:sysml="http://www.omg.org/spec/SysML/20181001/CoolingRAG/Requirements" setId="ER-P026" sourceRequirementId="P026" stakeholder="运维管理人员" generationBasis="original_requirement_and_supported_evidence_only" generatedAt="2026-05-28T11:23:59">
  <ProfessionalSummary>覆盖冷却水系统运行维护数据的记录与追溯要求，基于IACS UR E10、M3.1及调试程序证据，确保监控参数、报警及调试记录可追溯。</ProfessionalSummary>
  <EngineeringRequirements count="1">
    <Requirement id="ER-P026-01" level="1" requirementType="operation">
      <sysml:Name>运行维护数据记录与追溯</sysml:Name>
      <sysml:Text>冷却水系统应配置数据记录功能，对主机冷却水温度、压力、液位等关键参数进行连续监测和记录，所有报警信号应接入船舶报警管理系统，记录数据应可追溯。</sysml:Text>
      <sysml:VerifiedBy method="commissioning_check" />
      <sysml:DerivedFrom refId="ER-P026" />
      <sysml:Traceability>
        <Evidence id="E-CTRL-COOL-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-IACS-M3-002" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-COMM-COOL-001" supportStatus="verified_by_direct_evidence" />
        <Evidence id="E-SUPP-COMM-001" supportStatus="verified_by_direct_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>verified_by_direct_evidence</SupportStatus>
        <RiskIfUnmet>无法建立运行维护记录，导致维护决策缺乏数据支撑，增加设备故障风险。</RiskIfUnmet>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查监控系统设计图纸，确认温度、压力、液位等传感器信号已接入数据记录系统。</Criterion>
        <Criterion>调试期间验证所有报警信号在船舶报警管理系统中正确显示和记录。</Criterion>
        <Criterion>调试完成后提交联签清单、冷却液质检报告和仪表校准记录，确认数据可追溯。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【运行维护数据记录与追溯】，来自原始需求「便于建立运行维护记录，相关数据应能形成可追溯的运行维护数据」。E-CTRL-COOL-002支撑了UMS监控参数清单和报警接入要求；E-IACS-M3-002支撑了温度持续监控和报警要求；E-COMM-COOL-001支撑了调试记录要求；E-SUPP-COMM-001支撑了核查清单和记录提交要求。</sysml:EngineeringRationale>
