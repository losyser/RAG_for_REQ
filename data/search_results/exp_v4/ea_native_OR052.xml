		<UML:TaggedValue tag="id" xmi.id="EAID_D8086B86_2C46_43BF_9800_FB53C410B127" value="OR052" modelElement="EAID_8034AA07_054D_4FA4_AB09_900E43A5430D"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_DA5AF262_750D_49C7_8010_52B819DB23A1" value="&lt;memo&gt;#NOTES#[Source requirement] Space must be&#xA;provided for maintenance of the&#xA;cooling water pump seals,&#xA;bearings, and motor; it should not&#xA;be necessary to remove many pipes&#xA;just to dismantle a small&#xA;component." modelElement="EAID_8034AA07_054D_4FA4_AB09_900E43A5430D"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_A3F24D92_10A9_46C5_90EF_7CE2884A6525" value="OR052.1" modelElement="EAID_17C3FD3E_BD7F_48AB_8BA8_FAAA9FF320C5"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_CCEDC806_A1B2_4257_8853_692E901D801B" value="&lt;memo&gt;#NOTES#The cooling water pump seals,&#xA;bearings, and motor should be&#xA;arranged for direct removal and&#xA;installation without first&#xA;removing unrelated piping or other&#xA;equipment. (criterion:&#xA;{{TBD|unit:mm|ref:S21 Caterpillar&#xA;Cooling Systems Application and&#xA;Installation&#xA;Guide|component:cooling water&#xA;pump|intent:maintenance&#xA;space|hint:minimum clearance&#xA;dimensions required for removal of&#xA;seals, bearings, and motor must be&#xA;specified}}; grade: C; derivation:&#xA;Deferred; route: OPEN_ITEM)" modelElement="EAID_17C3FD3E_BD7F_48AB_8BA8_FAAA9FF320C5"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_0ACF0A19_EF63_4A0A_B3C2_244E1CBCA0FE" value="OR052.2" modelElement="EAID_292F49EE_2573_4BF1_B7F5_46836EEC4B74"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_62E6CE7E_6292_4AB8_89B1_AE885E229ADB" value="&lt;memo&gt;#NOTES#Sufficient maintenance space&#xA;should be provided around the&#xA;cooling water pump to facilitate&#xA;removal and installation of the&#xA;seals, bearings, and motor.&#xA;(criterion: {{TBD|unit:mm|ref:S21&#xA;Caterpillar Cooling Systems&#xA;Application and Installation&#xA;Guide|component:cooling water&#xA;pump|intent:maintenance&#xA;space|hint:minimum space&#xA;dimensions required for&#xA;maintenance operations must be&#xA;specified}}; grade: C; derivation:&#xA;Deferred; route: OPEN_ITEM)" modelElement="EAID_292F49EE_2573_4BF1_B7F5_46836EEC4B74"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_A12F33EA_1225_4318_9698_53DB42C425E3" value="OR052.3" modelElement="EAID_4FBDDF95_4EF6_45FE_B2DD_30DB54B00B6E"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_01C08729_E4BD_4EB6_AB0D_3AC3074B6D53" value="&lt;memo&gt;#NOTES#The piping arrangement for the&#xA;cooling water pump should allow&#xA;convenient access to the pump&#xA;seals, bearings, and motor, and&#xA;removal of these components should&#xA;not require moving a large amount&#xA;of piping. (criterion:&#xA;{{TBD|unit:mm|ref:S51 NASA NTRS&#xA;19800002357 Piping&#xA;Specification|component:cooling&#xA;water pump&#xA;piping|intent:maintenance&#xA;accessibility|hint:accessway or&#xA;space dimensions that the piping&#xA;arrangement should provide for&#xA;maintenance must be specified}};&#xA;grade: C; derivation: Deferred;&#xA;route: OPEN_ITEM)" modelElement="EAID_4FBDDF95_4EF6_45FE_B2DD_30DB54B00B6E"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_EACAC514_42AE_42AB_865A_21531F5B46E4" value="OR052.4" modelElement="EAID_296A2EF6_4A38_4B45_8EA9_38270B2F6EE0"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_A038FAA7_5B50_4015_B6B2_F905AC5DFA8F" value="&lt;memo&gt;#NOTES#The maintenance space for the&#xA;cooling water pump seals,&#xA;bearings, and motor should meet&#xA;the manufacturer&#x27;s specified&#xA;maintenance operation&#xA;requirements, ensuring that&#xA;maintenance can be performed&#xA;without removing unrelated piping.&#xA;(criterion: {{TBD|unit:mm|ref:S21&#xA;Caterpillar Cooling Systems&#xA;Application and Installation&#xA;Guide|component:cooling water&#xA;pump|intent:maintenance&#xA;space|hint:manufacturer-specified&#xA;maintenance space dimensions must&#xA;be specified}}; grade: C;&#xA;derivation: Deferred; route:&#xA;OPEN_ITEM)" modelElement="EAID_296A2EF6_4A38_4B45_8EA9_38270B2F6EE0"/>
