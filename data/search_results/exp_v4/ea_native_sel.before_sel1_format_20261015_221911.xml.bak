					<UML:ClassifierRole name="OR008.6  High Temperature Control Range Setting" xmi.id="EAID_5C53FA11_3FFD_497D_9218_0858C62983AB" visibility="public" base="EAID_11111111_5487_4080_A7F4_41526CB0AA00">
