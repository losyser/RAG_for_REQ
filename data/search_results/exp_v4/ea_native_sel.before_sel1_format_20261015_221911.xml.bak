						<UML:TaggedValue tag="author" value="cooling_rag_mg"/>
						<UML:TaggedValue tag="complexity" value="1"/>
						<UML:TaggedValue tag="status" value="Proposed"/>
						<UML:TaggedValue tag="stereotype" value="requirement"/>
						<UML:TaggedValue tag="ea_localid" value="41"/>
						<UML:TaggedValue tag="ea_eleType" value="element"/>
						<UML:TaggedValue tag="documentation" value="The setpoint of the temperature&#xA;control valve shall be checked&#xA;against the main engine&#xA;manufacturer&#x27;s technical data. The&#xA;high-temperature cooling water&#xA;engine outlet temperature shall be&#xA;controlled between 90 and 100°C,&#xA;and the electronic water&#xA;temperature controller shall&#xA;identify deviations via the engine&#xA;outlet sensor and correct the&#xA;reference value.&#xA;Criterion: 90-100°C&#xA;Grade: B&#xA;Derivation: Direct&#xA;Route: ENGINEER_CONFIRM --- cites manufacturer/operational&#xA;guidance only (tier-b)&#xA;Verification: Inspection&#xA;Cited: E-SYS-COMP-006"/>
						<UML:TaggedValue tag="style" value="BackColor=16770770;BorderColor=13395456;BorderWidth=2;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
						<UML:TaggedValue tag="$ea_xref_property" value="$XREFPROP=$XID={5C53FA11-3FFD-497D-9218-0858C62983AB}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=requirement;FQName=SysML1.4::requirement;@ENDSTEREO;$DES;$CLT={5C53FA11-3FFD-497D-9218-0858C62983AB}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
						</UML:ModelElement.taggedValue>
					</UML:ClassifierRole>
					<UML:ClassifierRole name="OR008.7  External Controller for Shared System" xmi.id="EAID_2939B477_1416_4453_B1F5_A68502303ADA" visibility="public" base="EAID_11111111_5487_4080_A7F4_41526CB0AA00">
