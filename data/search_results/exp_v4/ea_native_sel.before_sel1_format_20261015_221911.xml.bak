						<UML:TaggedValue tag="isActive" value="false"/>
						<UML:TaggedValue tag="package" value="EAPK_3CC4E5A4_E927_4a10_A9FD_CAEAF8808A43"/>
						<UML:TaggedValue tag="gentype" value="&lt;none&gt;"/>
						<UML:TaggedValue tag="tagged" value="0"/>
						<UML:TaggedValue tag="package_name" value=" 01_Requirements"/>
						<UML:TaggedValue tag="phase" value="1.0"/>
						<UML:TaggedValue tag="author" value="cooling_rag_mg"/>
						<UML:TaggedValue tag="complexity" value="1"/>
						<UML:TaggedValue tag="status" value="Proposed"/>
						<UML:TaggedValue tag="stereotype" value="requirement"/>
						<UML:TaggedValue tag="ea_localid" value="11"/>
						<UML:TaggedValue tag="ea_eleType" value="element"/>
						<UML:TaggedValue tag="documentation" value="When the seawater cooling system&#xA;is configured with a main&#xA;circulation pump, a low supply&#xA;alarm function shall be provided.&#xA;The alarm signal shall be capable&#xA;of being displayed on the bridge&#xA;or at the main control station so&#xA;that operators can promptly start&#xA;the standby pump or change over to&#xA;the standby pump.&#xA;Criterion: {{TBD|unit:MPa|ref:S43 ABS Marine&#xA;Vessel Rules Part 4&#xA;2021|component:Seawater cooling&#xA;system main circulation&#xA;pump|intent:Low supply alarm&#xA;threshold|hint:The alarm threshold&#xA;shall be determined based on the&#xA;manufacturer&#x27;s technical data or&#xA;project calculation documents and&#xA;shall not exceed the specific&#xA;manufacturer, engine model, and&#xA;control system configuration&#xA;scope}}&#xA;Grade: C&#xA;Derivation: Deferred&#xA;Route: OPEN_ITEM --- value deferred to named source&#xA;document&#xA;Verification: Test&#xA;Cited: E-HT-ALARM-001; E-PUMP-ALARM-002"/>
						<UML:TaggedValue tag="style" value="BackColor=13825535;BorderColor=26316;BorderWidth=2;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
						<UML:TaggedValue tag="$ea_xref_property" value="$XREFPROP=$XID={E7EB3E7A-0526-4AC0-9794-CA96DDC14968}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=requirement;FQName=SysML1.4::requirement;@ENDSTEREO;$DES;$CLT={E7EB3E7A-0526-4AC0-9794-CA96DDC14968}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
						</UML:ModelElement.taggedValue>
					</UML:ClassifierRole>
					<UML:ClassifierRole name="OR041.2  Cooling Water Pump Redundancy Requiremen" xmi.id="EAID_197E045B_D541_4476_BE91_248F97DC7794" visibility="public" base="EAID_11111111_5487_4080_A7F4_41526CB0AA00">
						<UML:ModelElement.stereotype>
							<UML:Stereotype name="requirement"/>
						</UML:ModelElement.stereotype>
						<UML:ModelElement.taggedValue>
						<UML:TaggedValue tag="isAbstract" value="false"/>
						<UML:TaggedValue tag="isSpecification" value="false"/>
						<UML:TaggedValue tag="ea_stype" value="Requirement"/>
						<UML:TaggedValue tag="ea_ntype" value="0"/>
						<UML:TaggedValue tag="version" value="1.0"/>
						<UML:TaggedValue tag="isActive" value="false"/>
						<UML:TaggedValue tag="package" value="EAPK_3CC4E5A4_E927_4a10_A9FD_CAEAF8808A43"/>
						<UML:TaggedValue tag="gentype" value="&lt;none&gt;"/>
						<UML:TaggedValue tag="tagged" value="0"/>
						<UML:TaggedValue tag="package_name" value=" 01_Requirements"/>
						<UML:TaggedValue tag="phase" value="1.0"/>
						<UML:TaggedValue tag="author" value="cooling_rag_mg"/>
						<UML:TaggedValue tag="complexity" value="1"/>
						<UML:TaggedValue tag="status" value="Proposed"/>
						<UML:TaggedValue tag="stereotype" value="requirement"/>
						<UML:TaggedValue tag="ea_localid" value="13"/>
						<UML:TaggedValue tag="ea_eleType" value="element"/>
						<UML:TaggedValue tag="documentation" value="The seawater cooling system shall&#xA;be provided with at least two&#xA;cooling water pumps, one of which&#xA;shall be a standby pump. The&#xA;capacity of the standby pump shall&#xA;not be less than the capacity of&#xA;the main pump, and at least one&#xA;pump shall be driven by an&#xA;independent drive unit.&#xA;Criterion: {{TBD|unit:unit|ref:S44 PRS Ship&#xA;Machinery Piping&#xA;Systems|component:Seawater cooling&#xA;water pump|intent:Pump quantity&#xA;and standby pump capacity|hint:At&#xA;least two pumps, one of which is a&#xA;standby pump; standby pump&#xA;capacity not less than main pump&#xA;capacity; at least one pump&#xA;independently driven}}&#xA;Grade: C&#xA;Derivation: Deferred&#xA;Route: OPEN_ITEM --- value deferred to named source&#xA;document&#xA;Verification: Inspection&#xA;Cited: E-PUMP-RED-004; E-PUMP-RED-002"/>
						<UML:TaggedValue tag="style" value="BackColor=13825535;BorderColor=26316;BorderWidth=2;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
						<UML:TaggedValue tag="$ea_xref_property" value="$XREFPROP=$XID={197E045B-D541-4476-BE91-248F97DC7794}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=requirement;FQName=SysML1.4::requirement;@ENDSTEREO;$DES;$CLT={197E045B-D541-4476-BE91-248F97DC7794}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
						</UML:ModelElement.taggedValue>
					</UML:ClassifierRole>
					<UML:ClassifierRole name="OR041.3  Standby Pump Start on Alarm" xmi.id="EAID_0B0124FB_F04A_4716_B493_24B08139E93F" visibility="public" base="EAID_11111111_5487_4080_A7F4_41526CB0AA00">
