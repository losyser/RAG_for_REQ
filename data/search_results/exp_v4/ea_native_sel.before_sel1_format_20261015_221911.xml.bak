						<UML:TaggedValue tag="gentype" value="&lt;none&gt;"/>
						<UML:TaggedValue tag="tagged" value="0"/>
						<UML:TaggedValue tag="package_name" value=" 01_Requirements"/>
						<UML:TaggedValue tag="phase" value="1.0"/>
						<UML:TaggedValue tag="author" value="cooling_rag_mg"/>
						<UML:TaggedValue tag="complexity" value="1"/>
						<UML:TaggedValue tag="status" value="Proposed"/>
						<UML:TaggedValue tag="stereotype" value="requirement"/>
						<UML:TaggedValue tag="ea_localid" value="19"/>
						<UML:TaggedValue tag="ea_eleType" value="element"/>
						<UML:TaggedValue tag="documentation" value="The threshold and actuation logic&#xA;of the seawater cooling system low&#xA;supply alarm shall be strictly&#xA;limited to the corresponding&#xA;manufacturer, engine model, and&#xA;control system configuration scope&#xA;and shall not be generalized&#xA;beyond that scope.&#xA;Criterion: {{TBD|unit:MPa|ref:S43 ABS Marine&#xA;Vessel Rules Part 4&#xA;2021|component:Seawater cooling&#xA;system main circulation&#xA;pump|intent:Low supply alarm&#xA;threshold|hint:The alarm threshold&#xA;shall be determined based on the&#xA;manufacturer&#x27;s technical data or&#xA;project calculation documents and&#xA;shall not exceed the specific&#xA;manufacturer, engine model, and&#xA;control system configuration&#xA;scope}}&#xA;Grade: C&#xA;Derivation: Deferred&#xA;Route: OPEN_ITEM --- value deferred to named source&#xA;document&#xA;Verification: Analysis&#xA;Cited: E-HT-ALARM-001; E-PUMP-ALARM-002"/>
						<UML:TaggedValue tag="style" value="BackColor=13825535;BorderColor=26316;BorderWidth=2;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
						<UML:TaggedValue tag="$ea_xref_property" value="$XREFPROP=$XID={9FF6B0A2-F8E2-4BDE-BBE7-F65754B2B3FB}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=requirement;FQName=SysML1.4::requirement;@ENDSTEREO;$DES;$CLT={9FF6B0A2-F8E2-4BDE-BBE7-F65754B2B3FB}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
						</UML:ModelElement.taggedValue>
					</UML:ClassifierRole>
