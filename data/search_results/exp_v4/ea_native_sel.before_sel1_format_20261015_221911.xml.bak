		</UML:Model>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_0690_7E89E23EA8F3" value="OR041" modelElement="EAID_E7B558E0_4C5F_49BC_BB9E_CFE76BC5481E"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_44BC_59389E53171A" value="&lt;memo&gt;#NOTES#[Source requirement] For the&#xA;seawater cooling system, if a main&#xA;circulation pump-related&#xA;configuration is adopted, a low&#xA;supply condition must be able to&#xA;trigger an alarm to facilitate&#xA;timely startup or changeover." modelElement="EAID_E7B558E0_4C5F_49BC_BB9E_CFE76BC5481E"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_0D17_A67323C20E76" value="OR041.1" modelElement="EAID_E7EB3E7A_0526_4AC0_9794_CA96DDC14968"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_E8F6_C1C4AB2053F6" value="&lt;memo&gt;#NOTES#When the seawater cooling system&#xA;is configured with a main&#xA;circulation pump, a low supply&#xA;alarm function shall be provided.&#xA;The alarm signal shall be capable&#xA;of being displayed on the bridge&#xA;or at the main control station so&#xA;that operators can promptly start&#xA;the standby pump or change over to&#xA;the standby pump. (criterion:&#xA;{{TBD|unit:MPa|ref:S43 ABS Marine&#xA;Vessel Rules Part 4&#xA;2021|component:Seawater cooling&#xA;system main circulation&#xA;pump|intent:Low supply alarm&#xA;threshold|hint:The alarm threshold&#xA;shall be determined based on the&#xA;manufacturer&#x27;s technical data or&#xA;project calculation documents and&#xA;shall not exceed the specific&#xA;manufacturer, engine model, and&#xA;control system configuration&#xA;scope}}; grade: C; derivation:&#xA;Deferred; route: OPEN_ITEM)" modelElement="EAID_E7EB3E7A_0526_4AC0_9794_CA96DDC14968"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_514C_81E3F6B3F1AA" value="OR041.2" modelElement="EAID_197E045B_D541_4476_BE91_248F97DC7794"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_35FD_014FA185F6B8" value="&lt;memo&gt;#NOTES#The seawater cooling system shall&#xA;be provided with at least two&#xA;cooling water pumps, one of which&#xA;shall be a standby pump. The&#xA;capacity of the standby pump shall&#xA;not be less than the capacity of&#xA;the main pump, and at least one&#xA;pump shall be driven by an&#xA;independent drive unit.&#xA;(criterion:&#xA;{{TBD|unit:unit|ref:S44 PRS Ship&#xA;Machinery Piping&#xA;Systems|component:Seawater cooling&#xA;water pump|intent:Pump quantity&#xA;and standby pump capacity|hint:At&#xA;least two pumps, one of which is a&#xA;standby pump; standby pump&#xA;capacity not less than main pump&#xA;capacity; at least one pump&#xA;independently driven}}; grade: C;&#xA;derivation: Deferred; route:&#xA;OPEN_ITEM)" modelElement="EAID_197E045B_D541_4476_BE91_248F97DC7794"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_6192_97F7CDDDAFE3" value="OR041.3" modelElement="EAID_0B0124FB_F04A_4716_B493_24B08139E93F"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_448D_AF831318ACD0" value="&lt;memo&gt;#NOTES#When the seawater cooling system&#xA;low supply alarm is triggered, the&#xA;standby pump shall be capable of&#xA;being started automatically or&#xA;manually, or changeover to the&#xA;standby pump shall be possible, to&#xA;restore the cooling water supply.&#xA;(criterion: {{TBD|unit:s|ref:S28&#xA;Wärtsilä 32 Product Guide, Cooling&#xA;Water System|component:Seawater&#xA;cooling system main circulation&#xA;pump|intent:Standby pump startup&#xA;or changeover response&#xA;time|hint:The response time shall&#xA;be determined based on the&#xA;manufacturer&#x27;s technical data or&#xA;project calculation documents and&#xA;shall not exceed the specific&#xA;manufacturer, engine model, and&#xA;control system configuration&#xA;scope}}; grade: C; derivation:&#xA;Deferred; route: OPEN_ITEM)" modelElement="EAID_0B0124FB_F04A_4716_B493_24B08139E93F"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_ABCD_544CE461A015" value="OR041.4" modelElement="EAID_02E93B7C_5ED4_4117_8AB6_6E3DB6F5087B"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_4CA5_6637E6830647" value="&lt;memo&gt;#NOTES#The sensor for the seawater&#xA;cooling system low supply alarm&#xA;shall be provided independently&#xA;and shall be capable of&#xA;continuously monitoring the&#xA;seawater cooling water supply&#xA;pressure or flow. The alarm signal&#xA;shall be transmitted to the engine&#xA;control system or alarm monitoring&#xA;system. (criterion:&#xA;{{TBD|unit:MPa|ref:S21 Caterpillar&#xA;Cooling Systems Application and&#xA;Installation&#xA;Guide|component:Seawater cooling&#xA;water pressure switch|intent:Low&#xA;supply alarm trigger&#xA;pressure|hint:The alarm trigger&#xA;pressure shall be determined based&#xA;on the manufacturer&#x27;s technical&#xA;data or project calculation&#xA;documents and shall not exceed the&#xA;specific manufacturer, engine&#xA;model, and control system&#xA;configuration scope}}; grade: C;&#xA;derivation: Deferred; route:&#xA;OPEN_ITEM)" modelElement="EAID_02E93B7C_5ED4_4117_8AB6_6E3DB6F5087B"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_2690_29744A85078C" value="OR041.5" modelElement="EAID_9FF6B0A2_F8E2_4BDE_BBE7_F65754B2B3FB"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_60F5_E4782A8837A1" value="&lt;memo&gt;#NOTES#The threshold and actuation logic&#xA;of the seawater cooling system low&#xA;supply alarm shall be strictly&#xA;limited to the corresponding&#xA;manufacturer, engine model, and&#xA;control system configuration scope&#xA;and shall not be generalized&#xA;beyond that scope. (criterion:&#xA;{{TBD|unit:MPa|ref:S43 ABS Marine&#xA;Vessel Rules Part 4&#xA;2021|component:Seawater cooling&#xA;system main circulation&#xA;pump|intent:Low supply alarm&#xA;threshold|hint:The alarm threshold&#xA;shall be determined based on the&#xA;manufacturer&#x27;s technical data or&#xA;project calculation documents and&#xA;shall not exceed the specific&#xA;manufacturer, engine model, and&#xA;control system configuration&#xA;scope}}; grade: C; derivation:&#xA;Deferred; route: OPEN_ITEM)" modelElement="EAID_9FF6B0A2_F8E2_4BDE_BBE7_F65754B2B3FB"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_D213_B8813AE526AE" value="OR052" modelElement="EAID_482A079E_839F_4CDD_8127_884D7E635F8F"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_F9A8_F463E843DD1D" value="&lt;memo&gt;#NOTES#[Source requirement] Space must be&#xA;provided for maintenance of the&#xA;cooling water pump seals,&#xA;bearings, and motor; it must not&#xA;be necessary to move many pipes&#xA;just to remove a small component." modelElement="EAID_482A079E_839F_4CDD_8127_884D7E635F8F"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_3676_D9484070B1C8" value="OR052.1" modelElement="EAID_26C5378F_EDB1_417E_A6CB_8120019F1B7D"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_306A_99919C465416" value="&lt;memo&gt;#NOTES#The seals, bearings, and motor of&#xA;the cooling water pump shall be&#xA;arranged so that they can be&#xA;directly removed and installed&#xA;without first moving unrelated&#xA;piping or other equipment.&#xA;(criterion: {{TBD|unit:mm|ref:S21&#xA;Caterpillar Cooling Systems&#xA;Application and Installation&#xA;Guide|component:Cooling water&#xA;pump|intent:Maintenance&#xA;space|hint:The minimum clearance&#xA;dimensions required for removal of&#xA;seals, bearings, and motor shall&#xA;be specified}}; grade: C;&#xA;derivation: Deferred; route:&#xA;OPEN_ITEM)" modelElement="EAID_26C5378F_EDB1_417E_A6CB_8120019F1B7D"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_3638_AE28F1B77887" value="OR052.2" modelElement="EAID_F6BC97EE_4A42_42C6_A577_A68A8E297D9F"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_B7B0_D64DE2AB6C2B" value="&lt;memo&gt;#NOTES#Sufficient maintenance space shall&#xA;be provided around the cooling&#xA;water pump to facilitate removal&#xA;and installation of the seals,&#xA;bearings, and motor. (criterion:&#xA;{{TBD|unit:mm|ref:S21 Caterpillar&#xA;Cooling Systems Application and&#xA;Installation&#xA;Guide|component:Cooling water&#xA;pump|intent:Maintenance&#xA;space|hint:The minimum space&#xA;dimensions required for&#xA;maintenance operations shall be&#xA;specified}}; grade: C; derivation:&#xA;Deferred; route: OPEN_ITEM)" modelElement="EAID_F6BC97EE_4A42_42C6_A577_A68A8E297D9F"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_0DCB_F6AFE6CE258F" value="OR052.3" modelElement="EAID_E06D79C9_9613_4AE1_9113_6D8DD30E45F8"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_DCFA_42A1F0D20939" value="&lt;memo&gt;#NOTES#The piping arrangement of the&#xA;cooling water pump shall allow&#xA;convenient access to the pump&#xA;seals, bearings, and motor, and&#xA;removal of these components shall&#xA;not require moving a large amount&#xA;of piping. (criterion:&#xA;{{TBD|unit:mm|ref:S51 NASA NTRS&#xA;19800002357 Piping&#xA;Specification|component:Cooling&#xA;water pump&#xA;piping|intent:Maintenance&#xA;accessibility|hint:The access&#xA;passage or space dimensions to be&#xA;provided by the piping arrangement&#xA;shall be specified}}; grade: C;&#xA;derivation: Deferred; route:&#xA;OPEN_ITEM)" modelElement="EAID_E06D79C9_9613_4AE1_9113_6D8DD30E45F8"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_03DC_77EABEF599B1" value="OR052.4" modelElement="EAID_2F251DA0_0F65_4649_B225_4C31E1F93FC7"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_6E8A_E90B130BADF4" value="&lt;memo&gt;#NOTES#The maintenance space for the&#xA;cooling water pump seals,&#xA;bearings, and motor shall meet the&#xA;manufacturer&#x27;s specified&#xA;maintenance operation&#xA;requirements, ensuring that&#xA;maintenance can be performed&#xA;without removing unrelated piping.&#xA;(criterion: {{TBD|unit:mm|ref:S21&#xA;Caterpillar Cooling Systems&#xA;Application and Installation&#xA;Guide|component:Cooling water&#xA;pump|intent:Maintenance&#xA;space|hint:The manufacturer-&#xA;specified maintenance space&#xA;dimensions shall be specified}};&#xA;grade: C; derivation: Deferred;&#xA;route: OPEN_ITEM)" modelElement="EAID_2F251DA0_0F65_4649_B225_4C31E1F93FC7"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_512E_0EA0C34A0A4A" value="OR008" modelElement="EAID_541EE4A6_7E08_4446_97C6_BA202B700741"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_7DA8_F8B4147D1893" value="&lt;memo&gt;#NOTES#[Source requirement] The setpoint&#xA;and installation position of the&#xA;temperature control valve must be&#xA;checked against the main engine&#xA;requirements; otherwise, the water&#xA;temperature may not be controlled&#xA;within the appropriate range." modelElement="EAID_541EE4A6_7E08_4446_97C6_BA202B700741"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_7D5C_140FC5B8B665" value="OR008.1" modelElement="EAID_AFEFADA0_5F4A_42C9_9C04_92DF6D57F2F0"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_49C4_301CA148A365" value="&lt;memo&gt;#NOTES#The setpoint of the temperature&#xA;control valve shall be checked&#xA;against the main engine&#xA;manufacturer&#x27;s technical data. The&#xA;high-temperature cooling water&#xA;engine outlet temperature setpoint&#xA;shall be 79°C nominal, and the&#xA;mechanical thermostatic element&#xA;adjustment range shall be 77-85°C.&#xA;(criterion: 79°C nominal;&#xA;mechanical thermostatic element&#xA;range 77-85°C; grade: B;&#xA;derivation: Direct; route:&#xA;ENGINEER_CONFIRM)" modelElement="EAID_AFEFADA0_5F4A_42C9_9C04_92DF6D57F2F0"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_8E93_1F6FE27AF615" value="OR008.2" modelElement="EAID_165C53AA_7E1D_4A47_8C64_F3D7044B18CA"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_99F1_5E17AB04D81D" value="&lt;memo&gt;#NOTES#The setpoint of the temperature&#xA;control valve shall be checked&#xA;against the main engine&#xA;manufacturer&#x27;s technical data. The&#xA;low-temperature cooling water&#xA;engine outlet temperature setpoint&#xA;shall be 35°C nominal, and the&#xA;mechanical thermostatic element&#xA;adjustment range shall be 29-41°C.&#xA;(criterion: 35°C nominal;&#xA;mechanical thermostatic element&#xA;range 29-41°C; grade: B;&#xA;derivation: Direct; route:&#xA;ENGINEER_CONFIRM)" modelElement="EAID_165C53AA_7E1D_4A47_8C64_F3D7044B18CA"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_132F_405AF415D3C1" value="OR008.3" modelElement="EAID_5B1FDB3E_BCE3_4822_8837_7E286457CF28"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_2B52_8D8AC5D22E64" value="&lt;memo&gt;#NOTES#The setpoint of the temperature&#xA;control valve shall be checked&#xA;against the main engine&#xA;manufacturer&#x27;s technical data. The&#xA;lubricating oil inlet temperature&#xA;setpoint shall be 66°C nominal,&#xA;and the mechanical thermostatic&#xA;element adjustment range shall be&#xA;63-72°C. (criterion: 66°C nominal;&#xA;mechanical thermostatic element&#xA;range 63-72°C; grade: B;&#xA;derivation: Direct; route:&#xA;ENGINEER_CONFIRM)" modelElement="EAID_5B1FDB3E_BCE3_4822_8837_7E286457CF28"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_2611_1AF101050534" value="OR008.4" modelElement="EAID_DE8F7A19_8E68_4950_9469_473A238B6ADA"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_8E3C_35667D4E80FA" value="&lt;memo&gt;#NOTES#The installation position of the&#xA;temperature control valve shall be&#xA;checked against the main engine&#xA;manufacturer&#x27;s requirements. The&#xA;three-way valve shall be installed&#xA;as a mixing valve, and its design&#xA;pressure loss shall be 0.3-0.6&#xA;bar. (criterion: 0.3-0.6 bar;&#xA;grade: B; derivation: Direct;&#xA;route: ENGINEER_CONFIRM)" modelElement="EAID_DE8F7A19_8E68_4950_9469_473A238B6ADA"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_038B_CC3EE8CEC72E" value="OR008.5" modelElement="EAID_3D1D66EC_0D19_46A1_A9A9_989153C538A7"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_E671_0E131012F3B7" value="&lt;memo&gt;#NOTES#The installation position of the&#xA;temperature control valve shall be&#xA;checked against the main engine&#xA;manufacturer&#x27;s requirements. The&#xA;pipe length between the&#xA;temperature sensor installation&#xA;position and the three-way valve&#xA;shall be maintained at 10 to 15&#xA;times the pipe diameter.&#xA;(criterion: 10 to 15 times the&#xA;pipe diameter; grade: C;&#xA;derivation: Direct; route:&#xA;ENGINEER_CONFIRM)" modelElement="EAID_3D1D66EC_0D19_46A1_A9A9_989153C538A7"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_FBE4_DFAF6EAA6B68" value="OR008.6" modelElement="EAID_5C53FA11_3FFD_497D_9218_0858C62983AB"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_EE60_E7FC6C1E7EE0" value="&lt;memo&gt;#NOTES#The setpoint of the temperature&#xA;control valve shall be checked&#xA;against the main engine&#xA;manufacturer&#x27;s technical data. The&#xA;high-temperature cooling water&#xA;engine outlet temperature shall be&#xA;controlled between 90 and 100°C,&#xA;and the electronic water&#xA;temperature controller shall&#xA;identify deviations via the engine&#xA;outlet sensor and correct the&#xA;reference value. (criterion:&#xA;90-100°C; grade: B; derivation:&#xA;Direct; route: ENGINEER_CONFIRM)" modelElement="EAID_5C53FA11_3FFD_497D_9218_0858C62983AB"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_F2EF_D545673293F2" value="OR008.7" modelElement="EAID_2939B477_1416_4453_B1F5_A68502303ADA"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_84C3_53CBE5B36879" value="&lt;memo&gt;#NOTES#The installation position of the&#xA;temperature control valve shall be&#xA;checked against the main engine&#xA;manufacturer&#x27;s requirements. When&#xA;multiple engines share a combined&#xA;low-temperature cooling water&#xA;system, an external temperature&#xA;controller shall be used. The&#xA;external controller shall be&#xA;installed at the engine control&#xA;room console and wired to the&#xA;temperature control valve.&#xA;(criterion:&#xA;{{TBD|unit:none|ref:S41 Everllence&#xA;49/60DF Project&#xA;Guide|component:Low-temperature&#xA;cooling water temperature control&#xA;valve|intent:Installation&#xA;position|hint:External temperature&#xA;controller installed at the engine&#xA;control room console and wired to&#xA;the temperature control valve}};&#xA;grade: C; derivation: Deferred;&#xA;route: OPEN_ITEM)" modelElement="EAID_2939B477_1416_4453_B1F5_A68502303ADA"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_FAD4_340821BF3216" value="OR008.8" modelElement="EAID_732EF7E5_9B4F_4DE2_9295_853CFE1D3325"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_6BFF_6EC09513EB30" value="&lt;memo&gt;#NOTES#The installation position of the&#xA;temperature control valve shall be&#xA;checked against the main engine&#xA;manufacturer&#x27;s requirements. When&#xA;engine-driven low-temperature&#xA;pumps are used to cool external&#xA;equipment, a common low-&#xA;temperature temperature control&#xA;valve shall be provided in the&#xA;external system. The common low-&#xA;temperature temperature control&#xA;valve shall be installed after the&#xA;central cooler and shall control&#xA;the water temperature before the&#xA;engine and external equipment by&#xA;partially bypassing the central&#xA;cooler. (criterion:&#xA;{{TBD|unit:none|ref:S28 Wärtsilä&#xA;32 Product Guide, Cooling Water&#xA;System|component:Common low-&#xA;temperature temperature control&#xA;valve|intent:Installation&#xA;position|hint:Common low-&#xA;temperature temperature control&#xA;valve installed after the central&#xA;cooler and controls the water&#xA;temperature before the engine and&#xA;external equipment by partially&#xA;bypassing the central cooler}};&#xA;grade: C; derivation: Deferred;&#xA;route: OPEN_ITEM)" modelElement="EAID_732EF7E5_9B4F_4DE2_9295_853CFE1D3325"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_4220_433F2343B3E7" value="OR008.9" modelElement="EAID_4C9883FB_6C90_4AC1_97A7_5F6BCEA24D7A"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_7405_3E8AFA65362B" value="&lt;memo&gt;#NOTES#The setpoint of the temperature&#xA;control valve shall be checked&#xA;against the main engine&#xA;manufacturer&#x27;s technical data. The&#xA;auxiliary engine outlet&#xA;temperature shall be maintained&#xA;constant at approximately 80°C.&#xA;(criterion: 80°C; grade: B;&#xA;derivation: Direct; route:&#xA;ENGINEER_CONFIRM)" modelElement="EAID_4C9883FB_6C90_4AC1_97A7_5F6BCEA24D7A"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_9F66_410C920FCD7F" value="OR008.10" modelElement="EAID_1311876D_A5B9_498F_AFFB_74D57BE4BE97"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_9B1F_900D9C39A2A3" value="&lt;memo&gt;#NOTES#The setpoint of the temperature&#xA;control valve shall be checked&#xA;against the main engine&#xA;manufacturer&#x27;s technical data. The&#xA;auxiliary engine outlet&#xA;temperature shall be maintained&#xA;constant at approximately 80°C.&#xA;(criterion: 80°C; grade: B;&#xA;derivation: Direct; route:&#xA;ENGINEER_CONFIRM)" modelElement="EAID_1311876D_A5B9_498F_AFFB_74D57BE4BE97"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_5570_AB69E2620B31" value="OR008.11" modelElement="EAID_F4C24671_1339_438C_ACF8_03DE7A41E990"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_0AE7_DD6D4A23A8A1" value="&lt;memo&gt;#NOTES#The setpoint and installation&#xA;position of the temperature&#xA;control valve shall be checked&#xA;against the main engine&#xA;manufacturer&#x27;s technical data or&#xA;project calculation documents. The&#xA;parameter confirmation path shall&#xA;follow the minimum temperature&#xA;control method of the cooling&#xA;system thermostatic control (inlet&#xA;control or outlet control), and&#xA;the maximum temperature shall be&#xA;controlled by correct sizing of&#xA;the radiator, heat exchanger, or&#xA;similar equipment. (criterion:&#xA;{{TBD|unit:none|ref:S21&#xA;Caterpillar Cooling Systems&#xA;Application and Installation&#xA;Guide|component:Temperature&#xA;control valve|intent:Setpoint and&#xA;installation position confirmation&#xA;path|hint:Determined based on the&#xA;main engine manufacturer&#x27;s&#xA;technical data or project&#xA;calculation documents,&#xA;distinguishing between inlet&#xA;control and outlet control&#xA;methods}}; grade: C; derivation:&#xA;Deferred; route: OPEN_ITEM)" modelElement="EAID_F4C24671_1339_438C_ACF8_03DE7A41E990"/>
