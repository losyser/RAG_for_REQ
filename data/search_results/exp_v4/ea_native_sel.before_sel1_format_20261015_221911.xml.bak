						<UML:TaggedValue tag="ea_localid" value="10"/>
						<UML:TaggedValue tag="ea_eleType" value="element"/>
						<UML:TaggedValue tag="documentation" value="[Source requirement] For the&#xA;seawater cooling system, if a main&#xA;circulation pump-related&#xA;configuration is adopted, a low&#xA;supply condition must be able to&#xA;trigger an alarm to facilitate&#xA;timely startup or changeover."/>
						<UML:TaggedValue tag="style" value="BackColor=15263976;BorderColor=7237230;BorderWidth=2;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
						<UML:TaggedValue tag="$ea_xref_property" value="$XREFPROP=$XID={E7B558E0-4C5F-49BC-BB9E-CFE76BC5481E}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=requirement;FQName=SysML1.4::requirement;@ENDSTEREO;$DES;$CLT={E7B558E0-4C5F-49BC-BB9E-CFE76BC5481E}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
