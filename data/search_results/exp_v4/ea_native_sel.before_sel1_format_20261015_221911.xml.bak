						<UML:TaggedValue tag="complexity" value="1"/>
						<UML:TaggedValue tag="status" value="Proposed"/>
						<UML:TaggedValue tag="stereotype" value="requirement"/>
						<UML:TaggedValue tag="ea_localid" value="37"/>
						<UML:TaggedValue tag="ea_eleType" value="element"/>
						<UML:TaggedValue tag="documentation" value="The installation position of the&#xA;temperature control valve shall be&#xA;checked against the main engine&#xA;manufacturer&#x27;s requirements. The&#xA;three-way valve shall be installed&#xA;as a mixing valve, and its design&#xA;pressure loss shall be 0.3-0.6&#xA;bar.&#xA;Criterion: 0.3-0.6 bar&#xA;Grade: B&#xA;Derivation: Direct&#xA;Route: ENGINEER_CONFIRM --- cites manufacturer/operational&#xA;guidance only (tier-b)&#xA;Verification: Inspection&#xA;Cited: E-TCV-TEMP-047"/>
						<UML:TaggedValue tag="style" value="BackColor=16770770;BorderColor=13395456;BorderWidth=2;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
