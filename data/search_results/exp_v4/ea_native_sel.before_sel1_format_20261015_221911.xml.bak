					<UML:ClassifierRole name="OR008.8  Common Low Temperature Control Valve" xmi.id="EAID_732EF7E5_9B4F_4DE2_9295_853CFE1D3325" visibility="public" base="EAID_11111111_5487_4080_A7F4_41526CB0AA00">
