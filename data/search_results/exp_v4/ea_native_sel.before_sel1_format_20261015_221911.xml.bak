						<UML:TaggedValue tag="gentype" value="&lt;none&gt;"/>
						<UML:TaggedValue tag="tagged" value="0"/>
						<UML:TaggedValue tag="package_name" value=" 01_Requirements"/>
						<UML:TaggedValue tag="phase" value="1.0"/>
						<UML:TaggedValue tag="author" value="cooling_rag_mg"/>
						<UML:TaggedValue tag="complexity" value="1"/>
						<UML:TaggedValue tag="status" value="Proposed"/>
						<UML:TaggedValue tag="stereotype" value="requirement"/>
						<UML:TaggedValue tag="ea_localid" value="15"/>
						<UML:TaggedValue tag="ea_eleType" value="element"/>
						<UML:TaggedValue tag="documentation" value="When the seawater cooling system&#xA;low supply alarm is triggered, the&#xA;standby pump shall be capable of&#xA;being started automatically or&#xA;manually, or changeover to the&#xA;standby pump shall be possible, to&#xA;restore the cooling water supply.&#xA;Criterion: {{TBD|unit:s|ref:S28 Wärtsilä 32&#xA;Product Guide, Cooling Water&#xA;System|component:Seawater cooling&#xA;system main circulation&#xA;pump|intent:Standby pump startup&#xA;or changeover response&#xA;time|hint:The response time shall&#xA;be determined based on the&#xA;manufacturer&#x27;s technical data or&#xA;project calculation documents and&#xA;shall not exceed the specific&#xA;manufacturer, engine model, and&#xA;control system configuration&#xA;scope}}&#xA;Grade: C&#xA;Derivation: Deferred&#xA;Route: OPEN_ITEM --- value deferred to named source&#xA;document&#xA;Verification: Test&#xA;Cited: E-COOLER-CTRL-001; E-PUMP-TEMP-003"/>
						<UML:TaggedValue tag="style" value="BackColor=13825535;BorderColor=26316;BorderWidth=2;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
						<UML:TaggedValue tag="$ea_xref_property" value="$XREFPROP=$XID={0B0124FB-F04A-4716-B493-24B08139E93F}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=requirement;FQName=SysML1.4::requirement;@ENDSTEREO;$DES;$CLT={0B0124FB-F04A-4716-B493-24B08139E93F}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
						</UML:ModelElement.taggedValue>
					</UML:ClassifierRole>
					<UML:ClassifierRole name="OR041.4  Independent Low Supply Alarm Sensor" xmi.id="EAID_02E93B7C_5ED4_4117_8AB6_6E3DB6F5087B" visibility="public" base="EAID_11111111_5487_4080_A7F4_41526CB0AA00">
						<UML:ModelElement.stereotype>
							<UML:Stereotype name="requirement"/>
						</UML:ModelElement.stereotype>
						<UML:ModelElement.taggedValue>
						<UML:TaggedValue tag="isAbstract" value="false"/>
						<UML:TaggedValue tag="isSpecification" value="false"/>
						<UML:TaggedValue tag="ea_stype" value="Requirement"/>
						<UML:TaggedValue tag="ea_ntype" value="0"/>
						<UML:TaggedValue tag="version" value="1.0"/>
						<UML:TaggedValue tag="isActive" value="false"/>
						<UML:TaggedValue tag="package" value="EAPK_3CC4E5A4_E927_4a10_A9FD_CAEAF8808A43"/>
						<UML:TaggedValue tag="gentype" value="&lt;none&gt;"/>
						<UML:TaggedValue tag="tagged" value="0"/>
						<UML:TaggedValue tag="package_name" value=" 01_Requirements"/>
						<UML:TaggedValue tag="phase" value="1.0"/>
						<UML:TaggedValue tag="author" value="cooling_rag_mg"/>
						<UML:TaggedValue tag="complexity" value="1"/>
						<UML:TaggedValue tag="status" value="Proposed"/>
						<UML:TaggedValue tag="stereotype" value="requirement"/>
						<UML:TaggedValue tag="ea_localid" value="17"/>
						<UML:TaggedValue tag="ea_eleType" value="element"/>
						<UML:TaggedValue tag="documentation" value="The sensor for the seawater&#xA;cooling system low supply alarm&#xA;shall be provided independently&#xA;and shall be capable of&#xA;continuously monitoring the&#xA;seawater cooling water supply&#xA;pressure or flow. The alarm signal&#xA;shall be transmitted to the engine&#xA;control system or alarm monitoring&#xA;system.&#xA;Criterion: {{TBD|unit:MPa|ref:S21 Caterpillar&#xA;Cooling Systems Application and&#xA;Installation&#xA;Guide|component:Seawater cooling&#xA;water pressure switch|intent:Low&#xA;supply alarm trigger&#xA;pressure|hint:The alarm trigger&#xA;pressure shall be determined based&#xA;on the manufacturer&#x27;s technical&#xA;data or project calculation&#xA;documents and shall not exceed the&#xA;specific manufacturer, engine&#xA;model, and control system&#xA;configuration scope}}&#xA;Grade: C&#xA;Derivation: Deferred&#xA;Route: OPEN_ITEM --- value deferred to named source&#xA;document&#xA;Verification: Inspection&#xA;Cited: E-PUMP-ALARM-002; E-COOLER-&#xA;CTRL-001"/>
						<UML:TaggedValue tag="style" value="BackColor=13825535;BorderColor=26316;BorderWidth=2;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
						<UML:TaggedValue tag="$ea_xref_property" value="$XREFPROP=$XID={02E93B7C-5ED4-4117-8AB6-6E3DB6F5087B}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=requirement;FQName=SysML1.4::requirement;@ENDSTEREO;$DES;$CLT={02E93B7C-5ED4-4117-8AB6-6E3DB6F5087B}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
						</UML:ModelElement.taggedValue>
					</UML:ClassifierRole>
					<UML:ClassifierRole name="OR041.5  Alarm Threshold Configuration Limitation" xmi.id="EAID_9FF6B0A2_F8E2_4BDE_BBE7_F65754B2B3FB" visibility="public" base="EAID_11111111_5487_4080_A7F4_41526CB0AA00">
