    <Requirement id="ER-P052-02" level="1" requirementType="corrosion_protection">
      <sysml:Name>阴极保护系统配置</sysml:Name>
      <sysml:Text>冷却水管道系统应设置牺牲阳极或外加电流阴极保护系统，以防止电化学腐蚀。</sysml:Text>
      <sysml:VerifiedBy method="review" />
      <sysml:DerivedFrom refId="ER-P052" />
      <sysml:Traceability>
        <Evidence id="E-SUPP-MAT-001" supportStatus="supported_by_indirect_evidence" />
      </sysml:Traceability>
      <sysml:QualityStatus>
        <SupportStatus>supported_by_indirect_evidence</SupportStatus>
        <RiskIfUnmet>缺少阴极保护将导致异种金属连接处发生电偶腐蚀，加速管道损坏。</RiskIfUnmet>
        <ApplicabilityConstraint>本条基于DNV规则，适用于DNV级船舶；其他船级社应参照相应规则确认。</ApplicabilityConstraint>
      </sysml:QualityStatus>
      <sysml:AcceptanceCriteria>
        <Criterion>检查设计图纸，确认在海水侧管道或异种金属连接处设置了牺牲阳极或外加电流阴极保护系统。</Criterion>
        <Criterion>阴极保护系统的设计参数（如阳极数量、电流输出）按厂家Technical Data确认。</Criterion>
      </sysml:AcceptanceCriteria>
      <sysml:EngineeringRationale>本条覆盖方面【阴极保护系统配置】，来自原始需求「设置牺牲阳极或外加电流阴极保护系统」。E-SUPP-MAT-001（DNV规则）提及异种金属连接须设绝缘或阴极保护，间接支撑了阴极保护配置要求。</sysml:EngineeringRationale>
