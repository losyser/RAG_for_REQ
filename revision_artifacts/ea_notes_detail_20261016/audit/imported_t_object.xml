:schemas-microsoft-com:datatypes" dt:dt="bin.base64"/></Row><Row><Object_ID>3</Object_ID><Object_Type>Requirement</Object_Type><Diagram_ID>0</Diagram_ID><Name>Pump Redundancy and Protection</Name><Alias xmlns:dt="urn:schemas-microsoft-com:datatypes" dt:dt="bin.base64"/><Author>cooling_rag_mg</Author><Version>1.0</Version><Note>The main engine cooling water system shall be equipped with at least two cooling water pumps, at least one of which shall be independently electrically driven. Each pump shall be capable of independently meeting the cooling water flow requirement at the rated power of the main engine. The system shall provide high-temperature alarms and automatic protection to prevent inadequate cooling capacity, interruption of cooling water circulation or loss of temperature control from impairing the safe operation of the propulsion plant.</Note><Package_ID>2</Package_ID><Stereotype>requirement</Stereotype><NType>0</NType><Complexity>1</Complexity><Effort>0</Effort><Style xmlns:dt="urn:schemas-microsoft-com:datatypes" dt:dt="bin.base64"/><Backcolor>13825535</Backcolor><BorderStyle>0</BorderStyle><BorderWidth>2</BorderWidth><Fontcolor>-1</Fontcolor><Bordercolor>26316</Bordercolor><CreatedDate>2026-10-16 19:11:48</CreatedDate><ModifiedDate>2026-10-16 19:11:48</ModifiedDate><Status>Proposed</Status><Abstract>0</Abstract><Tagged>0</Tagged><PDATA1>Proposed</PDATA1><PDATA2 xmlns:dt="urn:schemas-microsoft-com:datatypes" dt:dt="bin.base64"/><PDATA3 xmlns:dt="urn:schemas-microsoft-com:datatypes" dt:dt="bin.base64"/><PDATA4 xmlns:dt="urn:schemas-microsoft-com:datatypes" dt:dt="bin.base64"/><PDATA5 xmlns:dt="urn:schemas-microsoft-com:datatypes" dt:dt="bin.base64"/><Concurrency xmlns:dt="urn:schemas-microsoft-com:datatypes" dt:dt="bin.base64"/><Visibility xmlns:dt="urn:schemas-microsoft-com:datatypes" dt:dt="bin.base64"/><Persistence xmlns:dt="urn:schemas-microsoft-com:datatypes" dt:dt="bin.base64"/><Cardinality xmlns:dt="urn:schemas-microsoft-com:datatypes" dt:dt="bin