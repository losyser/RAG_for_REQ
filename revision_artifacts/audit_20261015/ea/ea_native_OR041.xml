		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_FD4B_A967B45E47CF" value="OR041" modelElement="EAID_DE9C1D7B_95CD_4000_965B_1865812AC824"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_78D6_037B759DEB71" value="&lt;memo&gt;#NOTES#For the seawater cooling system, if a main circulation pump-related configuration is adopted, a low supply condition must be able to trigger an alarm to facilitate timely startup or changeover." modelElement="EAID_DE9C1D7B_95CD_4000_965B_1865812AC824"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_D2CD_10BAB4ADA208" value="OR041.1" modelElement="EAID_731E2DA7_6174_4472_98F2_1798C68CE502"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_EF76_F4BFA3222A10" value="&lt;memo&gt;#NOTES#When the seawater cooling system is configured with a main circulation pump, a low supply alarm function shall be provided. The alarm signal shall be capable of being displayed on the bridge or at the main control station so that operators can promptly start the standby pump or change over to the standby pump." modelElement="EAID_731E2DA7_6174_4472_98F2_1798C68CE502"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_AF8A_5B5F00E4C45D" value="OR041.2" modelElement="EAID_3285A185_F54D_482E_860D_DB2FC990BACE"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_1A36_214F5899A0B2" value="&lt;memo&gt;#NOTES#The seawater cooling system shall be provided with at least two cooling water pumps, one of which shall be a standby pump. The capacity of the standby pump shall not be less than the capacity of the main pump, and at least one pump shall be driven by an independent drive unit." modelElement="EAID_3285A185_F54D_482E_860D_DB2FC990BACE"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_E6D3_1C218984FC7B" value="OR041.3" modelElement="EAID_326741BC_6ACE_4952_AFC7_52E12A7BAF75"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_A88D_9DD3FD527C69" value="&lt;memo&gt;#NOTES#When the seawater cooling system low supply alarm is triggered, the standby pump shall be capable of being started automatically or manually, or changeover to the standby pump shall be possible, to restore the cooling water supply." modelElement="EAID_326741BC_6ACE_4952_AFC7_52E12A7BAF75"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_DA06_0882658BBA0F" value="OR041.4" modelElement="EAID_4153FA00_32FB_4379_8306_2804B5F0CE81"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_61E6_8A5B669F47FB" value="&lt;memo&gt;#NOTES#The sensor for the seawater cooling system low supply alarm shall be provided independently and shall be capable of continuously monitoring the seawater cooling water supply pressure or flow. The alarm signal shall be transmitted to the engine control system or alarm monitoring system." modelElement="EAID_4153FA00_32FB_4379_8306_2804B5F0CE81"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_BBBE_FC9F453BC340" value="OR041.5" modelElement="EAID_C5464D64_0B58_4333_80D7_19270CA14C33"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_9AF6_299FE72A0731" value="&lt;memo&gt;#NOTES#The threshold and actuation logic of the seawater cooling system low supply alarm shall be strictly limited to the corresponding manufacturer, engine model, and control system configuration scope and shall not be generalized beyond that scope." modelElement="EAID_C5464D64_0B58_4333_80D7_19270CA14C33"/>
