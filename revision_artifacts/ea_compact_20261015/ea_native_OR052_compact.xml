		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_302C_28A779ABB44E" value="&lt;memo&gt;#NOTES#Space must be provided for maintenance of the cooling water pump seals, bearings, and motor; it must not be necessary to move many pipes just to remove a small component." modelElement="EAID_BC886A53_E9F1_4333_9DA6_D119EA5861D4"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_0AC9_522230BB9D9C" value="OR052.1" modelElement="EAID_EC3A268C_084E_464C_8E89_454DC9F00F19"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_D9C3_F6EA1C973D23" value="&lt;memo&gt;#NOTES#The seals, bearings, and motor of the cooling water pump shall be arranged so that they can be directly removed and installed without first moving unrelated piping or other equipment." modelElement="EAID_EC3A268C_084E_464C_8E89_454DC9F00F19"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_883D_76C0DE9A40BA" value="OR052.2" modelElement="EAID_97077EBB_50AD_4D19_A95F_C95D0BD9E433"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_7C94_47887A21743B" value="&lt;memo&gt;#NOTES#Sufficient maintenance space shall be provided around the cooling water pump to facilitate removal and installation of the seals, bearings, and motor." modelElement="EAID_97077EBB_50AD_4D19_A95F_C95D0BD9E433"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_3462_660F9F6E87D2" value="OR052.3" modelElement="EAID_D9B6701B_3B0E_4FC2_BC0B_DDE1928098F1"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_3426_68A6D454D6BB" value="&lt;memo&gt;#NOTES#The piping arrangement of the cooling water pump shall allow convenient access to the pump seals, bearings, and motor, and removal of these components shall not require moving a large amount of piping." modelElement="EAID_D9B6701B_3B0E_4FC2_BC0B_DDE1928098F1"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_9D7A_F9B59C09CF56" value="OR052.4" modelElement="EAID_163C37DC_8DFE_43A4_BDC6_3CDA320A8086"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_EEB0_E6A9E936518E" value="&lt;memo&gt;#NOTES#The maintenance space for the cooling water pump seals, bearings, and motor shall meet the manufacturer's specified maintenance operation requirements, ensuring that maintenance can be performed without removing unrelated piping." modelElement="EAID_163C37DC_8DFE_43A4_BDC6_3CDA320A8086"/>
