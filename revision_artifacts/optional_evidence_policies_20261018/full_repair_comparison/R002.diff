, "supported_evidence": [{"id": "E-DNV-COOL-001", "support_type": "direct", "evidence_role": "primary", "judge_reason": "DNV规则明确要求主机冷却水进机温度保持在厂家限值内，HT回路进机温度不超过调温阀开启温度+36°C，直接支撑本需求中温度参数限值的要求。", "text": "DNV Rules for Classification: Ships, Pt.4 Ch.3 — Cooling Water Systems\nThe cooling water system for main propulsion engines shall be designed so that the cooling water temperatures at the engine inlet are maintained within the limits specified by the engine manufacturer. For high-temperature (HT) fresh water circuits, the maximum inlet temperature to the engine shall not exceed 36°C above the thermostat opening temperature under worst-case ambient conditions.", "topic": "主机冷却水系统温度设计要求（DNV规则）", "source_document": "S61 DNV Rules for Classification Ships Pt4 Ch3 Machinery", "source_type": "ship_rule", "location": "", "evidence_strength": "direct", "is_generalizable": "general", "applicability_level": "class_rule", "manufacturer": "", "engine_model": "", "system_type": ["HT cooling water loop", "LT cooling water loop"], "component_objects": ["main_engine_cooling_water_system", "temperature_control_valve", "central_cooling_system"], "requirement_intents": ["parameter_limit", "capacity", "system_design"], "engineering_phase": ["basic_design", "detailed_design", "class_approval"], "applicable_condition": ["normal_operation"], "can_support": ["parameter_limit", "capacity", "system_design"], "limitation": "", "normalized_summary": "DNV规则要求主机冷却水进机温度应保持在厂家限值内，HT回路进机温度不超过调温阀开启温度+36°C，中央冷却系统按最高海水温度设计。", "supportable_requirements": [], "unsupported_requirements": "", "constraint": {"强制级别": "强制", "约束类型": "parameter_limit", "适用对象": "主机冷却水系统", "核心要求": "主机冷却水系统应设计为在发动机进口处的冷却水温度保持在发动机制造商规定的限值内。", "可接受标准": "≤36°C（高温淡水回路最高进口温度与恒温器开启温度之差）", "验证方式": "设计审查", "关联条文": []}, "_context_status": "partial_unknown", "_omitted_metadata_fields": [], "_missing_applicability_fields": ["engine_model"], "_extracted_values": [], "_omitted_parameter_records": 0, "_extraction_status": "unknown_historical", 