		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_78D6_037B759DEB71" value="&lt;memo&gt;#NOTES#For the seawater cooling system, if a main circulation pump-related configuration is adopted, a low supply condition must be able to trigger an alarm to facilitate timely startup or changeover." modelElement="EAID_DE9C1D7B_95CD_4000_965B_1865812AC824"/>
		<UML:TaggedValue tag="id" xmi.id="EAID_00000DED_3AF1_773a_D2CD_10BAB4ADA208" value="OR041.1" modelElement="EAID_731E2DA7_6174_4472_98F2_1798C68CE502"/>
		<UML:TaggedValue tag="text" xmi.id="EAID_00415985_D789_37d7_EF76_F4BFA3222A10" value="&lt;memo&gt;#NOTES#When the seawater cooling system is configured with a main circulation pump, a low supply alarm function shall be provided. The alarm signal shall be capable of being displayed on the bridge or at the main control station so that operators can promptly start the standby pump or change over to the standby pump." modelElement="EAID_731E2DA7_6174_4472_98F2_1798C68CE502"/>
